#!/usr/bin/env bash
set -euo pipefail

# --- Configuration ---
VERSION="1.17.0"
DEFAULT_INTERVAL=300
CARD_WIDTH=46
BAR_WIDTH=16
API_BASE="https://claude.ai/api"

# --- Colors & Formatting ---
USE_COLOR=true
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
ORANGE='\033[38;5;208m'
GRAY='\033[38;5;245m'

# Box drawing
TL='┌' TR='┐' BL='└' BR='┘' H='─' V='│'

# Progress bar chars
FILLED='█'
EMPTY='░'

# --- Argument Parsing ---
INTERVAL=$DEFAULT_INTERVAL
ONCE=false
SHOW_HELP=false
DO_SYNC=false

while [[ $# -gt 0 ]]; do
    case $1 in
        sync)
            DO_SYNC=true
            shift
            ;;
        --interval)
            INTERVAL="${2:?--interval requires a value}"
            shift 2
            ;;
        --once)
            ONCE=true
            shift
            ;;
        --no-color)
            USE_COLOR=false
            shift
            ;;
        --help|-h)
            SHOW_HELP=true
            shift
            ;;
        --version)
            echo "claude-dashboard-cli $VERSION"
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
done

if $SHOW_HELP; then
    cat <<'EOF'
Usage: claude-dashboard-cli [command] [options]

Commands:
  sync              Scan Chrome, Arc, Brave, or Edge for Claude sessions and save accounts
  (default)         Show usage dashboard

Options:
  --interval <sec>  Refresh interval in seconds (default: 300)
  --once            Show dashboard once and exit
  --no-color        Disable colors
  --version         Show version
  --help            Show this help
EOF
    exit 0
fi

if ! $USE_COLOR; then
    BOLD='' DIM='' RESET='' RED='' GREEN='' YELLOW='' BLUE='' PURPLE='' ORANGE='' GRAY=''
fi

# Install hints differ per platform: a Linux user has no Homebrew.
install_hint() {
    local mac linux
    case "$1" in
        jq)  mac="brew install jq"
             linux="apt install jq   (or: dnf install jq)" ;;
        cli) mac="brew install haiz/claude-dashboard/claude-dashboard-cli"
             linux="curl -fsSL https://raw.githubusercontent.com/haiz/claude-dashboard/main/install.sh | bash" ;;
        *)   return 1 ;;
    esac
    if [[ "$(uname -s)" == "Darwin" ]]; then echo "$mac"; else echo "$linux"; fi
}

# --- Locate helper binary ---
HELPER="$(dirname "$0")/claude-dashboard-helper"
if [[ ! -x "$HELPER" ]]; then
    # Try Homebrew location (macOS)
    HELPER="$(brew --prefix 2>/dev/null)/bin/claude-dashboard-helper" 2>/dev/null || true
fi
if [[ ! -x "$HELPER" ]]; then
    # Try PATH (Linux .deb / .AppImage install at /usr/bin)
    if command -v claude-dashboard-helper >/dev/null 2>&1; then
        HELPER="$(command -v claude-dashboard-helper)"
    fi
fi
if [[ ! -x "$HELPER" ]]; then
    echo "Error: claude-dashboard-helper not found." >&2
    echo "Install via: $(install_hint cli)" >&2
    exit 1
fi

if $DO_SYNC; then
    exec "$HELPER" sync
fi

# --- Helper Functions ---

color_for_pct() {
    local pct=$1
    if ! $USE_COLOR; then echo ""; return; fi
    local r g
    if (( pct <= 50 )); then
        r=$(( pct * 5 ))
        g=255
    else
        r=255
        g=$(( 255 - (pct - 50) * 5 ))
    fi
    (( r > 255 )) && r=255; (( r < 0 )) && r=0
    (( g > 255 )) && g=255; (( g < 0 )) && g=0
    printf '\033[38;2;%d;%d;0m' "$r" "$g"
}

plan_color() {
    local plan="$1"
    case "$plan" in
        Pro)       echo -ne "$BLUE" ;;
        "Max 5x")  echo -ne "$PURPLE" ;;
        "Max 20x") echo -ne "$ORANGE" ;;
        Max)       echo -ne "$PURPLE" ;;
        *)         echo -ne "$GRAY" ;;
    esac
}

progress_bar() {
    local pct=$1
    local filled=$(( pct * BAR_WIDTH / 100 ))
    (( filled > BAR_WIDTH )) && filled=$BAR_WIDTH
    local empty=$(( BAR_WIDTH - filled ))
    local color
    color=$(color_for_pct "$pct")

    printf '%b' "$color"
    local i
    for (( i=0; i<filled; i++ )); do printf '%s' "$FILLED"; done
    printf '%b' "$RESET$DIM"
    for (( i=0; i<empty; i++ )); do printf '%s' "$EMPTY"; done
    printf '%b' "$RESET"
}

# BSD date (macOS) parses with -j -f and formats an epoch with -r; GNU date
# (Linux) uses -d for both, and no relevant flag is shared. Detected once at
# load: the flavour cannot change mid-run.
if date -j -f "%Y" "2000" "+%s" >/dev/null 2>&1; then
    DATE_FLAVOUR=bsd
else
    DATE_FLAVOUR=gnu
fi

# One place per flavour, so format_reset_time itself reads the same on both.
iso_to_epoch() {
    if [[ "$DATE_FLAVOUR" == "gnu" ]]; then
        # GNU -d accepts all three shapes the API returns in one call.
        date -d "$1" "+%s" 2>/dev/null
    else
        # BSD date has no ISO8601 mode, so the offset has to be spelled +HHMM
        # and the fractional seconds removed before %z can read it. Parsing
        # "${1%%.*}" instead cuts at the *first* dot, which throws the offset
        # away with the fraction — and BSD date reads an offset-less string as
        # local time, so a UTC instant lands wrong by the local offset.
        local norm
        norm=$(printf '%s' "$1" | sed -E 's/\.[0-9]+//; s/Z$/+0000/; s/([+-][0-9]{2}):([0-9]{2})$/\1\2/')
        date -jf "%Y-%m-%dT%H:%M:%S%z" "$norm" "+%s" 2>/dev/null || \
        date -jf "%Y-%m-%dT%H:%M:%S"   "${1%%.*}" "+%s" 2>/dev/null
    fi
}

epoch_fmt() {
    if [[ "$DATE_FLAVOUR" == "gnu" ]]; then
        date -d "@$1" "+$2"
    else
        date -r "$1" "+$2"
    fi
}

format_reset_time() {
    local iso="$1"
    if [[ -z "$iso" || "$iso" == "null" ]]; then
        echo ""
        return
    fi
    # Parse ISO8601 and format as "Sat 3p"
    local epoch
    epoch=$(iso_to_epoch "$iso") || { echo ""; return; }
    [[ -n "$epoch" ]] || { echo ""; return; }
    local day hour ampm
    day=$(epoch_fmt "$epoch" "%a")
    hour=$(epoch_fmt "$epoch" "%-I")
    ampm=$(epoch_fmt "$epoch" "%p" | tr '[:upper:]' '[:lower:]' | head -c1)
    echo "${day} ${hour}${ampm}"
}

# Fable has no top-level usage field: it is derived from the limits[] entry
# whose scope.model.display_name is "Fable", reading percent (not utilization).
# Rule and cases: contract/cases/usage-decoding.json. Prints "percent<TAB>resets_at"
# (resets_at may be empty), or nothing when no Fable entry exists.
fable_from_usage_json() {
    echo "$1" | jq -r '
        [.limits[]? | select(.scope.model.display_name? == "Fable")][0]
        | if . == null then empty else "\(.percent // 0)\t\(.resets_at // "")" end
    ' 2>/dev/null || true
}

# --- Render Functions ---

render_header() {
    local timestamp
    timestamp=$(date "+%H:%M:%S")
    local left="Claude Dashboard"
    local right="refreshed $timestamp"
    local padding=$(( CARD_WIDTH - ${#left} - ${#right} - 1 ))
    printf ' %b%s%b' "$BOLD" "$left" "$RESET"
    for (( i=0; i<padding; i++ )); do printf ' '; done
    printf '%b%s%b\n' "$DIM" "$right" "$RESET"
    printf ' '
    local i
    for (( i=0; i<CARD_WIDTH; i++ )); do printf '%s' "$H"; done
    printf '\n'
}

render_card() {
    local name="$1" plan="$2" status="$3"
    local pct_5h="$4" reset_5h="$5"
    local pct_7d="$6" reset_7d="$7"
    local pct_fable="$8" reset_fable="$9"

    local pcolor
    pcolor=$(plan_color "$plan")

    local i

    # Header: ┌─ email ─────────── Plan ──┐
    local inner=$(( CARD_WIDTH - 2 ))
    local plan_part=" $plan "
    local name_part=" $name "
    # Truncate name if too long
    local max_name=$(( inner - ${#plan_part} - 4 ))
    if (( ${#name_part} > max_name )); then
        name_part=" ${name:0:$((max_name - 3))}.. "
    fi
    local dashes_needed=$(( inner - ${#name_part} - ${#plan_part} - 2 ))
    (( dashes_needed < 1 )) && dashes_needed=1

    printf ' %s%s' "$TL" "$H"
    printf '%b%s%b' "$BOLD" "$name_part" "$RESET"
    for (( i=0; i<dashes_needed; i++ )); do printf '%s' "$H"; done
    printf '%b%s%b' "$pcolor" "$plan_part" "$RESET"
    printf '%s%s\n' "$H" "$TR"

    if [[ "$status" != "active" ]]; then
        local msg="  Session $status"
        printf ' %s' "$V"
        printf '%b' "$DIM"
        printf '%-*s' "$inner" "$msg"
        printf '%b%s\n' "$RESET" "$V"
    else
        render_usage_row "5h" "$pct_5h" "$reset_5h"
        render_usage_row "7d" "$pct_7d" "$reset_7d"
        if [[ -n "$pct_fable" && "$pct_fable" != "null" && "$pct_fable" != "" ]]; then
            render_usage_row "F " "$pct_fable" "$reset_fable"
        fi
    fi

    # Footer
    printf ' %s' "$BL"
    for (( i=0; i<inner; i++ )); do printf '%s' "$H"; done
    printf '%s\n' "$BR"
}

render_usage_row() {
    local label="$1" pct_raw="$2" reset_str="$3"
    local pct=${pct_raw%.*}  # truncate decimals
    (( pct > 100 )) && pct=100
    (( pct < 0 )) && pct=0

    local inner=$(( CARD_WIDTH - 2 ))

    local reset_display=""
    if [[ -n "$reset_str" && "$reset_str" != "" ]]; then
        reset_display="resets $reset_str"
    fi

    local pct_str
    printf -v pct_str '%3d%%' "$pct"

    # "│  5h  ████████░░░░░░░░  52%  resets Sat 3p│"
    local prefix="  ${label}  "
    local mid="  ${pct_str}  "
    local used=$(( ${#prefix} + BAR_WIDTH + ${#mid} + ${#reset_display} ))
    local pad=$(( inner - used ))
    (( pad < 0 )) && pad=0

    # Print prefix
    printf ' %s%s' "$V" "$prefix"
    # Print progress bar directly (no subshell capture)
    progress_bar "$pct"
    # Print rest
    printf '%s' "$mid$reset_display"
    local i
    for (( i=0; i<pad; i++ )); do printf ' '; done
    printf '%s\n' "$V"
}

render_footer() {
    if $ONCE; then return; fi
    local remaining=$1
    local mins=$(( remaining / 60 ))
    local secs=$(( remaining % 60 ))
    printf '\n %b↻ Next refresh in %d:%02d  |  Ctrl+C to quit%b\n' "$DIM" "$mins" "$secs" "$RESET"
}

# --- Main Logic ---

fetch_and_render() {
    # Get accounts from helper
    local accounts_json
    accounts_json=$("$HELPER" decrypt 2>/dev/null) || {
        echo "No accounts found. Run: claude-dashboard-cli sync" >&2
        return 1
    }

    local count
    count=$(echo "$accounts_json" | jq 'length')

    # Clear screen and render header
    printf '\033[H\033[2J'
    render_header
    printf '\n'

    for (( idx=0; idx<count; idx++ )); do
        local name plan status orgId sessionKey
        name=$(echo "$accounts_json" | jq -r ".[$idx].name")
        plan=$(echo "$accounts_json" | jq -r ".[$idx].plan")
        status=$(echo "$accounts_json" | jq -r ".[$idx].status")
        orgId=$(echo "$accounts_json" | jq -r ".[$idx].orgId")
        sessionKey=$(echo "$accounts_json" | jq -r ".[$idx].sessionKey")

        if [[ "$status" != "active" || -z "$orgId" || "$orgId" == "null" || -z "$sessionKey" || "$sessionKey" == "null" ]]; then
            render_card "$name" "$plan" "$status" 0 "" 0 "" "" ""
            printf '\n'
            continue
        fi

        # Fetch usage via helper (uses URLSession to bypass Cloudflare)
        local usage_json
        usage_json=$("$HELPER" usage "$orgId" "$sessionKey" 2>/dev/null) || usage_json="{}"
        [[ -z "$usage_json" ]] && usage_json="{}"

        local pct_5h pct_7d reset_5h_raw reset_7d_raw reset_5h reset_7d
        local fable_line pct_fable reset_fable_raw reset_fable

        pct_5h=$(echo "$usage_json" | jq -r '.five_hour.utilization // 0' 2>/dev/null || echo 0)
        pct_7d=$(echo "$usage_json" | jq -r '.seven_day.utilization // 0' 2>/dev/null || echo 0)
        reset_5h_raw=$(echo "$usage_json" | jq -r '.five_hour.resets_at // ""' 2>/dev/null || echo "")
        reset_7d_raw=$(echo "$usage_json" | jq -r '.seven_day.resets_at // ""' 2>/dev/null || echo "")
        reset_5h=$(format_reset_time "$reset_5h_raw")
        reset_7d=$(format_reset_time "$reset_7d_raw")

        # Fable (optional) — derived from limits[], see fable_from_usage_json
        fable_line=$(fable_from_usage_json "$usage_json")
        pct_fable="" reset_fable_raw=""
        if [[ -n "$fable_line" ]]; then
            pct_fable="${fable_line%%$'\t'*}"
            reset_fable_raw="${fable_line#*$'\t'}"
        fi
        reset_fable=$(format_reset_time "$reset_fable_raw")

        render_card "$name" "$plan" "$status" \
            "$pct_5h" "$reset_5h" \
            "$pct_7d" "$reset_7d" \
            "$pct_fable" "$reset_fable"
        printf '\n'
    done
}

# When sourced by a test, stop here: definitions only, no dashboard.
if [[ -n "${CLAUDE_DASHBOARD_CLI_TEST:-}" ]]; then
    return 0 2>/dev/null || exit 0
fi

# --- Entry Point ---

# Check jq
if ! command -v jq &>/dev/null; then
    echo "Error: jq is required. Install via: $(install_hint jq)" >&2
    exit 1
fi

# Trap Ctrl+C for clean exit
trap 'printf "\033[?25h\n"; exit 0' INT TERM

# Hide cursor
printf '\033[?25l'

if $ONCE; then
    fetch_and_render
    printf '\033[?25h'
    exit 0
fi

while true; do
    fetch_and_render

    # Countdown
    for (( remaining=INTERVAL; remaining>0; remaining-- )); do
        render_footer "$remaining"
        sleep 1
        # Move cursor up to overwrite footer
        printf '\033[2A'
    done
done
