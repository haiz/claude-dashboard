    { "name": "utilization change makes one account active", "operations": [{ "kind": "success", "account_id": "a", "utilization": 10.0, "resets_at": 1000.0, "at": 0.0 }, { "kind": "success", "account_id": "a", "utilization": 11.0, "resets_at": 1000.0, "at": 10.0 }], "checks": [{ "account_id": "a", "at": 10.0, "expect_active": true }] },
    { "name": "reset jitter within sixty seconds is the same cycle", "operations": [{ "kind": "success", "account_id": "a", "utilization": 10.0, "resets_at": 1000.0, "at": 0.0 }, { "kind": "success", "account_id": "a", "utilization": 10.0, "resets_at": 1060.0, "at": 10.0 }], "checks": [{ "account_id": "a", "at": 10.0, "expect_active": false }] },
    { "name": "reset movement beyond sixty seconds makes the account active", "operations": [{ "kind": "success", "account_id": "a", "utilization": 10.0, "resets_at": 1000.0, "at": 0.0 }, { "kind": "success", "account_id": "a", "utilization": 10.0, "resets_at": 1061.0, "at": 10.0 }], "checks": [{ "account_id": "a", "at": 10.0, "expect_active": true }] },
    { "name": "activity expires only after six hundred seconds", "operations": [{ "kind": "success", "account_id": "a", "utilization": 10.0, "resets_at": 1000.0, "at": 0.0 }, { "kind": "success", "account_id": "a", "utilization": 11.0, "resets_at": 1000.0, "at": 100.0 }], "checks": [{ "account_id": "a", "at": 699.999, "expect_active": true }, { "account_id": "a", "at": 700.0, "expect_active": true }, { "account_id": "a", "at": 700.001, "expect_active": false }] },
    { "name": "failed refresh does not extend activity", "operations": [{ "kind": "success", "account_id": "a", "utilization": 10.0, "resets_at": 1000.0, "at": 0.0 }, { "kind": "success", "account_id": "a", "utilization": 11.0, "resets_at": 1000.0, "at": 1.0 }, { "kind": "failed", "account_id": "a", "at": 400.0 }], "checks": [{ "account_id": "a", "at": 601.001, "expect_active": false }] },
    { "name": "accounts have independent activity state", "operations": [{ "kind": "success", "account_id": "a", "utilization": 10.0, "resets_at": 1000.0, "at": 0.0 }, { "kind": "success", "account_id": "b", "utilization": 10.0, "resets_at": 1000.0, "at": 0.0 }, { "kind": "success", "account_id": "a", "utilization": 11.0, "resets_at": 1000.0, "at": 10.0 }], "checks": [{ "account_id": "a", "at": 10.0, "expect_active": true }, { "account_id": "b", "at": 10.0, "expect_active": false }] }
