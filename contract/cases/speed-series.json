{
  "factors": [
    {"plan": "Pro", "factor": 0.1}, {"plan": "Max 5x", "factor": 0.5},
    {"plan": "Max 20x", "factor": 2.0}, {"plan": "Max", "factor": 1.0},
    {"plan": "Team", "factor": 0.1}, {"plan": "Enterprise", "factor": 0.1},
    {"plan": "Free", "factor": 0.1}
  ],
  "series": [
