[
  {"name": "live 5h, rising, no reset", "window": "5h", "from": 0, "to": 18000, "now": 18000, "points": [[-60, 2], [600, 2], [9000, 5], [17940, 9]], "expect": {"end_is_now": true, "start_pct": 2, "end_pct": 9}},
  {"name": "start interpolates between the points around from", "window": "5h", "from": 0, "to": 3600, "now": 3600, "points": [[-100, 10], [100, 20], [3000, 30]], "expect": {"end_is_now": true, "start_pct": 15, "end_pct": 30}},
  {"name": "same rounded value hides the percentages", "window": "5h", "from": 0, "to": 18000, "now": 18000, "points": [[-60, 2.2], [9000, 2.4]], "expect": {"end_is_now": true, "start_pct": null, "end_pct": null}},
  {"name": "rounding half away from zero makes them differ", "window": "5h", "from": 0, "to": 18000, "now": 18000, "points": [[-60, 2.4], [9000, 2.5]], "expect": {"end_is_now": true, "start_pct": 2, "end_pct": 3}},
  {"name": "a reset inside the window hides them", "window": "5h", "from": 0, "to": 18000, "now": 18000, "points": [[-60, 40], [3000, 60], [3600, 0], [9000, 10]], "expect": {"end_is_now": true, "start_pct": null, "end_pct": null}},
  {"name": "a reset exactly at from is outside the window", "window": "5h", "from": 0, "to": 18000, "now": 18000, "points": [[-1, 60], [0, 0], [9000, 10]], "expect": {"end_is_now": true, "start_pct": 0, "end_pct": 10}},
  {"name": "a reset after to is outside the window", "window": "5h", "from": 0, "to": 7200, "now": 20000, "points": [[-60, 5], [3600, 20], [7200, 30], [10000, 0]], "expect": {"end_is_now": false, "start_pct": 5, "end_pct": 30}},
  {"name": "5h window wider than 5h hides them", "window": "5h", "from": 0, "to": 86400, "now": 86400, "points": [[-60, 2], [80000, 9]], "expect": {"end_is_now": true, "start_pct": null, "end_pct": null}},
  {"name": "7d window over 7d shows them", "window": "7d", "from": 0, "to": 604800, "now": 604800, "points": [[-600, 10], [300000, 30], [604000, 46]], "expect": {"end_is_now": true, "start_pct": 10, "end_pct": 46}},
  {"name": "7d window over 30d hides them", "window": "7d", "from": 0, "to": 2592000, "now": 2592000, "points": [[-600, 10], [604000, 46]], "expect": {"end_is_now": true, "start_pct": null, "end_pct": null}},
  {"name": "F window never shows them", "window": "F", "from": 0, "to": 18000, "now": 18000, "points": [[-60, 2], [9000, 9]], "expect": {"end_is_now": true, "start_pct": null, "end_pct": null}},
  {"name": "no data at or before from hides them", "window": "5h", "from": 0, "to": 18000, "now": 18000, "points": [[600, 2], [9000, 9]], "expect": {"end_is_now": true, "start_pct": null, "end_pct": null}},
  {"name": "end 60 s before now still reads now", "window": "5h", "from": 0, "to": 3540, "now": 3600, "points": [[-60, 2], [3000, 9]], "expect": {"end_is_now": true, "start_pct": 2, "end_pct": 9}},
  {"name": "end 61 s before now is a time, interpolated", "window": "5h", "from": 0, "to": 3539, "now": 3600, "points": [[-61, 2], [3539, 5], [3600, 9]], "expect": {"end_is_now": false, "start_pct": 2, "end_pct": 5}}
]
