{
  "manifest_version": 3,
  "name": "Claude Dashboard Sync",
  "description": "Sends your claude.ai session to the local Claude Dashboard app.",
  "version": "1.18.1",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "alarms", "storage"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude Dashboard Sync"
  }
}
