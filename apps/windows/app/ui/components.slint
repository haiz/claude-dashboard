import { Theme, UiRow, UiWindow } from "theme.slint";
import { HistoryBox } from "chart.slint";
import { Spinner } from "std-widgets.slint";

// Sidebar row: coloured tile + Segoe Fluent glyph + label. Hover/selected highlight.
export component SidebarRow inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <color> tile: #808080;
    in property <string> initial; // when set, the tile is a round avatar showing this letter
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <color> text-color: #1a1a1a;
    in property <color> hover-color: #00000010;
    in property <color> selected-color: #00000020;
    // Trailing mark (macOS account row): a coloured percent, or the orange expired triangle.
    in property <string> trailing;
    in property <color> trailing-color: #808080;
    in property <bool> warning: false;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    // macOS sidebar: the selected row is filled with the accent colour, its label white.
    background: root.selected ? Theme.accent : (touch.has-hover && root.enabled ? root.hover-color : transparent);
    opacity: root.enabled ? 1.0 : 0.45;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        alignment: start;
        // Account avatars are 20 pt on macOS, the static rows' icon tiles 22.
        Rectangle {
            width: root.initial != "" ? 20px : 22px;
            height: self.width;
            y: (parent.height - self.height) / 2;
            border-radius: root.initial != "" ? self.width / 2 : 5px;
            background: root.tile;
            Text {
                text: root.initial != "" ? root.initial : root.glyph;
                font-family: root.initial != "" ? "Segoe UI Variable" : "Segoe Fluent Icons";
                font-size: root.initial != "" ? 10px : 12px;
                font-weight: root.initial != "" ? 600 : 400;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.label;
            color: root.selected ? #ffffff : root.text-color;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.warning: Text {
            text: "\u{E7BA}";
            font-family: "Segoe Fluent Icons";
            font-size: 13px;
            color: #ff9f0a;
            vertical-alignment: center;
        }
        if !root.warning && root.trailing != "": Text {
            text: root.trailing;
            font-size: 12px;
            color: root.trailing-color;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Ring gauge: track + Rust-built progress arc (core::geometry) + centered percent.
export component UsageGauge inherits Rectangle {
    in property <UiWindow> win;
    in property <float> zoom: 1.0;
    width: root.win.diameter * root.zoom * 1px;
    height: root.win.diameter * root.zoom * 1px;
    // Track: full circle at the same radius/stroke as the arc.
    Rectangle {
        width: parent.width - root.win.line-width * root.zoom * 1px;
        height: self.width;
        x: root.win.line-width * root.zoom * 0.5px;
        y: self.x;
        border-radius: self.width / 2;
        border-width: root.win.line-width * root.zoom * 1px;
        // macOS track: `Color.primary.opacity(0.2)`.
        border-color: Theme.dark ? #ffffff33 : #00000033;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: root.win.diameter;
        viewbox-height: root.win.diameter;
        commands: root.win.gauge-path;
        stroke: root.win.color;
        stroke-width: root.win.line-width * root.zoom * 1px;
        stroke-line-cap: round;
        fill: transparent;
        animate stroke { duration: 300ms; easing: ease-out; }
    }
    // macOS: the number at 0.33 x diameter (semibold) and a smaller "%" at 0.20 x diameter
    // on its baseline (core::geometry::percent_font_size / percent_sign_font_size).
    property <length> d: root.win.diameter * root.zoom * 1px;
    HorizontalLayout {
        alignment: center;
        Text {
            text: floor(root.win.percent);
            color: Theme.text-primary;
            // macOS `minimumScaleFactor(0.7)`: three digits shrink to stay inside the ring.
            font-size: root.d * 0.33 * (root.win.percent >= 100 ? 0.8 : 1.0);
            font-weight: 600;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            // Drop the sign to the number's baseline: half the gap between the two cap heights.
            padding-top: root.d * (0.33 - 0.20) * 0.5;
            Text {
                text: "%";
                color: Theme.text-primary;
                font-size: root.d * 0.20;
            }
        }
    }
}

// Usage bar: fill width animates; colour comes from core::colors via the row.
export component UsageBar inherits Rectangle {
    in property <float> fraction;
    in property <color> fill-color;
    height: 6px;
    border-radius: 3px;
    background: Theme.dark ? #ffffff22 : #00000014;
    Rectangle {
        x: 0px;
        width: parent.width * clamp(root.fraction, 0.0, 1.0);
        height: parent.height;
        border-radius: 3px;
        background: root.fill-color;
        animate width { duration: 300ms; easing: ease-out; }
    }
}

export component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint;
    in property <length> size: 32px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.tint;
    Text {
        text: root.initial;
        color: white;
        font-size: root.size * 0.45;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A clickable ring (macOS `CircularProgressView` / the countdown clock as a button): on
// hover it grows 6% and glows in its colour, with a pointing hand and a tooltip.
component RingButton inherits Rectangle {
    in property <color> glow;
    in property <string> tip;
    callback clicked();
    border-radius: self.width / 2;
    // An opaque disc while hovered, so the glow shows around the ring, not through it.
    background: touch.has-hover ? Theme.card-bg : transparent;
    transform-scale: touch.has-hover ? 1.06 : 1.0;
    animate transform-scale { duration: 280ms; easing: ease-out; }
    drop-shadow-color: touch.has-hover ? root.glow.with-alpha(0.35) : transparent;
    drop-shadow-blur: touch.has-hover ? 6px : 0px;
    @children
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tooltip { text: @markdown("\{root.tip}"); }
}

// One gauge column on the card (macOS UsageBar, compact): mono label, usage ring with the
// burn-rate animal at its bottom-right, then the segmented countdown ring beside it with the
// reset label above. Only the two rings open that window's chart, as on macOS.
export component WindowColumn inherits Rectangle {
    in property <string> label;
    in property <UiWindow> win;
    // Fable has no countdown column (it resets in lockstep with 7d).
    in property <bool> countdown: true;
    callback clicked();
    // Compact (flyout) or full (dashboard, account page) metrics, as macOS `isCompact`:
    // 52 / 34 px rings with 4 px countdown stroke, or 68 / 44 px with 5 px.
    in property <bool> compact: true;
    property <length> big-d: root.compact ? 52px : 68px;
    property <float> big-zoom: root.big-d / (root.win.diameter * 1px);
    property <length> small-d: root.compact ? 34px : 44px;
    property <length> small-stroke: root.compact ? 4px : 5px;
    property <string> tip: "Open the " + (root.label == "F" ? "Fable" : root.label) + " usage chart";
    width: col.preferred-width;
    height: col.preferred-height;

    col := VerticalLayout {
        spacing: 5px;
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-family: "Consolas";
            font-size: root.compact ? 10px : 13px;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            spacing: root.compact ? 5px : 8px;
            alignment: center;
            RingButton {
                width: root.big-d;
                height: root.big-d;
                glow: root.win.color;
                tip: root.tip;
                clicked => { root.clicked(); }
                UsageGauge { win: root.win; zoom: root.big-zoom; }
                if root.win.animal != "": Text {
                    x: parent.width - self.preferred-width + 4px;
                    y: parent.height - self.preferred-height + 4px;
                    text: root.win.animal;
                    font-size: root.compact ? 10px : 13px;
                }
            }
            if root.countdown && root.win.reset-label != "": VerticalLayout {
                alignment: end;
                spacing: 2px;
                // macOS: 8 pt monospaced at both sizes.
                Text {
                    text: root.win.reset-label;
                    color: Theme.text-secondary;
                    font-family: "Consolas";
                    font-size: 8px;
                    horizontal-alignment: center;
                }
                RingButton {
                    width: root.small-d;
                    height: root.small-d;
                    glow: root.win.countdown-color;
                    tip: root.tip;
                    clicked => { root.clicked(); }
                    // Segmented track (macOS `Color.primary.opacity(0.08)`), then the live
                    // segments; both are built in Rust at this ring's size, so the viewbox is 1:1.
                    for p in root.compact ? root.win.track-compact : root.win.track: Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: root.small-d / 1px;
                        viewbox-height: root.small-d / 1px;
                        commands: p;
                        stroke: Theme.dark ? #ffffff14 : #00000014;
                        stroke-width: root.small-stroke;
                        fill: transparent;
                    }
                    for seg in root.compact ? root.win.segments-compact : root.win.segments: Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: root.small-d / 1px;
                        viewbox-height: root.small-d / 1px;
                        commands: seg.path;
                        stroke: seg.color;
                        stroke-width: root.small-stroke;
                        fill: transparent;
                    }
                    Text {
                        text: root.win.countdown;
                        color: Theme.text-primary.with-alpha(0.85);
                        font-family: "Consolas";
                        font-size: root.compact ? 8px : 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// macOS SF Symbols bolt / bolt.fill and flame / flame.fill, drawn as paths (Lucide "zap" and
// "flame", ISC licence) so the outline and filled forms match (Segoe Fluent Icons has neither pair).
export component BoltIcon inherits Path {
    in property <bool> filled;
    in property <color> tint;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z";
    fill: root.filled ? root.tint : transparent;
    stroke: root.tint;
    stroke-width: 1.6px;
}

export component FlameIcon inherits Path {
    in property <bool> filled;
    in property <color> tint;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z";
    fill: root.filled ? root.tint : transparent;
    stroke: root.tint;
    stroke-width: 1.6px;
}

export component AccountCard inherits Rectangle {
    in property <UiRow> data;
    // Compact metrics for the flyout; the Dashboard passes false (full-size rings).
    in property <bool> compact: true;
    // Plan capsule colour (macOS badgeColor): Pro blue, Max 5x purple, Max 20x orange, Max purple.
    property <color> plan-tint: root.data.plan == "Pro" ? #0a84ff
        : root.data.plan == "Max 20x" ? #ff9f0a
        : #bf5af2;
    // Claude Code Switch (macOS AccountCard `onSwitchClaudeCode`); `cc-switching` disables it.
    in property <bool> cc-switching;
    callback switch-cc();
    callback toggle-home();
    callback toggle-pin(bool /* new pinned state */);
    callback resync();
    // The card itself is not clickable (macOS passes no `onTap`); its rings open the charts.
    callback open-window(string /* "5h" | "7d" | "fable" */);
    // The card sizes itself from its content (an error or hint line never clips).
    // A grid row may stretch it to its tallest card (a max-height here would use the
    // unwrapped height and clip wrapped hint lines).
    preferred-height: lay.preferred-height;
    background: Theme.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-border;

    ContextMenuArea {
        Menu {
            MenuItem {
                title: root.data.pinned ? "Unpin" : "Pin to Top";
                activated => { root.toggle-pin(!root.data.pinned); }
            }
        }
    }

    lay := VerticalLayout {
        padding: 14px;
        spacing: 12px;
        alignment: start;
        // Header: name (+ active dot) over email, pin icon, plan capsule, expired triangle.
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    // macOS `.title3`: 15 pt, regular weight.
                    Text {
                        text: root.data.name;
                        color: Theme.text-primary;
                        font-size: 15px;
                        overflow: elide;
                    }
                    if root.data.claude-code: Rectangle {
                        width: 8px; height: 8px; y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: Theme.ok;
                        Tooltip { text: @markdown("Currently active in Claude Code"); }
                    }
                }
                if root.data.email != "" && root.data.email != root.data.name: Text {
                    text: root.data.email;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    overflow: elide;
                }
            }
            if root.data.pinned: Text {
                text: "\u{E718}";
                font-family: "Segoe Fluent Icons";
                font-size: 12px;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            // Critical flame: orange outline for critical, red filled for high critical.
            if root.data.critical-level > 0: Rectangle {
                width: 20px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                FlameIcon {
                    filled: root.data.critical-level == 2;
                    tint: root.data.critical-level == 2 ? #ff453a : #ff9f0a;
                }
                Tooltip { text: @markdown("\{root.data.critical-help}"); }
            }
            // Home after reset (bolt): Claude Code comes back here after each 5h reset.
            if root.data.shows-home: Rectangle {
                width: 26px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: bolt-touch.has-hover ? Theme.text-primary.with-alpha(0.10) : transparent;
                BoltIcon {
                    filled: root.data.is-home;
                    tint: root.data.is-home ? #ff9f0a : Theme.text-secondary;
                }
                bolt-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.toggle-home(); }
                }
                Tooltip {
                    text: root.data.is-home
                        ? @markdown("Ticked: Claude Code comes back here each time its 5h limit resets. Click to cancel")
                        : @markdown("Switch Claude Code here each time its 5h limit resets");
                }
            }
            // Switch Claude Code here: hidden on the active account (the badge marks it).
            if root.data.switch-state != "" && root.data.switch-state != "active": Rectangle {
                width: 26px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                opacity: root.cc-switching ? 0.4 : 1.0;
                background: sw-touch.has-hover && !root.cc-switching ? Theme.text-primary.with-alpha(0.10) : transparent;
                Text {
                    text: "\u{E8AB}";
                    font-family: "Segoe Fluent Icons";
                    font-size: 13px;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                sw-touch := TouchArea {
                    enabled: !root.cc-switching;
                    mouse-cursor: pointer;
                    clicked => { root.switch-cc(); }
                }
                Tooltip { text: @markdown("\{root.data.switch-help}"); }
            }
            Rectangle {
                width: plan.preferred-width + 12px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 10px;
                background: root.plan-tint.with-alpha(0.15);
                plan := Text {
                    text: root.data.plan;
                    color: Theme.text-primary;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.data.loading: Spinner {
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                indeterminate: true;
            }
            if !root.data.loading && root.data.expired: Text {
                text: "\u{E7BA}";
                font-family: "Segoe Fluent Icons";
                font-size: 14px;
                color: #ff9f0a;
                vertical-alignment: center;
            }
        }
        if root.data.expired: VerticalLayout {
            spacing: 8px;
            Text {
                text: "Session expired.";
                color: Theme.text-secondary;
                font-size: 11px;
            }
            if root.data.expired-hint != "": Text {
                text: root.data.expired-hint;
                color: Theme.text-secondary;
                font-size: 11px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    height: 24px;
                    width: rs.preferred-width + 20px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    background: rs-touch.has-hover ? Theme.accent.with-alpha(0.15) : transparent;
                    rs := Text {
                        text: "Re-sync";
                        color: Theme.accent;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    rs-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.resync(); }
                    }
                    Tooltip { text: @markdown("Read a fresh session key from the browser"); }
                }
            }
            // Windows keeps a failed Re-sync's message here (macOS shows none on the card).
            if root.data.error != "": Text {
                text: root.data.error;
                color: Theme.danger;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
        // macOS shows the error only when there is no usage to show; a failed refresh
        // keeps the last-good gauges instead.
        if !root.data.expired && root.data.error != ""
            && !root.data.five-hour.present && !root.data.seven-day.present: Text {
            text: root.data.error;
            color: Theme.danger;
            font-size: 12px;
            wrap: word-wrap;
        }
        if !root.data.expired: HorizontalLayout {
            // macOS UsageGaugeRow: 20 pt apart compact, 30 pt regular.
            spacing: root.compact ? 20px : 30px;
            alignment: center;
            if root.data.five-hour.present: WindowColumn {
                label: "5h"; win: root.data.five-hour; compact: root.compact;
                clicked => { root.open-window("5h"); }
            }
            if root.data.seven-day.present: WindowColumn {
                label: "7d"; win: root.data.seven-day; compact: root.compact;
                clicked => { root.open-window("7d"); }
            }
            if root.data.fable.present: WindowColumn {
                label: "F"; win: root.data.fable; countdown: false; compact: root.compact;
                clicked => { root.open-window("fable"); }
            }
        }
    }
}

// Full-size 5h / 7d / Fable gauge row (macOS UsageGaugeRow, isCompact false). Fable only
// when present. Each column opens that window's chart.
export component UsageGaugeRow inherits HorizontalLayout {
    in property <UiRow> data;
    callback open-window(string /* "5h" | "7d" | "fable" */);
    spacing: 30px;
    alignment: end;
    if root.data.five-hour.present: WindowColumn {
        label: "5h"; win: root.data.five-hour; compact: false;
        clicked => { root.open-window("5h"); }
    }
    if root.data.seven-day.present: WindowColumn {
        label: "7d"; win: root.data.seven-day; compact: false;
        clicked => { root.open-window("7d"); }
    }
    if root.data.fable.present: WindowColumn {
        label: "F"; win: root.data.fable; countdown: false; compact: false;
        clicked => { root.open-window("fable"); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> tint: Theme.accent;
    // Hover tooltip (macOS `.help`); empty shows none.
    in property <string> tip;
    // Optional Segoe Fluent glyph before the label (macOS `Label(_, systemImage:)`).
    in property <string> glyph;
    callback clicked();
    height: 32px;
    width: row.preferred-width + 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: root.enabled ? (touch.has-hover ? root.tint.with-alpha(0.15) : Theme.card-bg) : transparent;
    opacity: root.enabled ? 1.0 : 0.45;
    row := HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2;
        width: self.preferred-width;
        spacing: 6px;
        if root.glyph != "": Text {
            text: root.glyph;
            font-family: "Segoe Fluent Icons";
            font-size: 13px;
            color: root.enabled ? root.tint : Theme.text-secondary;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.enabled ? root.tint : Theme.text-secondary;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

// On/off switch (the Settings > General toggles use the same shape).
component PaneSwitch inherits Rectangle {
    in property <bool> checked;
    callback toggled();
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Theme.accent : Theme.card-border;
    Rectangle {
        width: 16px; height: 16px; border-radius: 8px; background: #ffffff;
        y: 3px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        animate x { duration: 120ms; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// A titled, rounded box (macOS PaneSection).
component PaneSection inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    if root.title != "": Text {
        text: root.title;
        color: Theme.text-primary;
        font-size: 14px;
        font-weight: 600;
    }
    Rectangle {
        height: inner.preferred-height;
        background: Theme.card-bg;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.card-border;
        inner := VerticalLayout {
            padding: 12px;
            spacing: 10px;
            @children
        }
    }
}

component ActionRow inherits HorizontalLayout {
    in property <string> title;
    spacing: 10px;
    Text {
        text: root.title;
        color: Theme.text-primary;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
    @children
}

// Per-account page (macOS AccountPane): header with this account's Refresh, a summary box
// (avatar, name, status, full-size gauges) and an Actions box.
export component AccountPane inherits VerticalLayout {
    in property <UiRow> data;
    // True while any refresh runs; disables Refresh.
    in property <bool> refreshing;
    callback refresh();
    callback resync();
    callback ping();
    in property <bool> cc-switching;
    callback switch-cc();
    // Claude Desktop (macOS "Switch Desktop to this account"): shown on the account Claude
    // Code uses while Desktop is signed in as another; disabled while a Desktop switch runs.
    in property <bool> desktop-differs;
    in property <bool> desktop-switching;
    callback switch-desktop();
    callback toggle-home();
    callback toggle-pin(bool /* new pinned state */);
    callback remove();
    callback window-picked(string /* "5h" | "7d" | "fable" */);
    // Only the visible page owns the History chart (one chart state, one pane per row).
    in property <bool> active: true;
    callback open-window(string /* "5h" | "7d" | "fable" */);
    property <bool> confirming-remove: false;
    property <color> plan-tint: root.data.plan == "Pro" ? #0a84ff
        : root.data.plan == "Max 20x" ? #ff9f0a
        : #bf5af2;
    spacing: 12px;

    // PaneHeader
    HorizontalLayout {
        spacing: 10px;
        // macOS PaneHeader: `.title2.bold()`.
        Text {
            text: root.data.name;
            color: Theme.text-primary;
            font-size: 17px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.data.loading: Spinner {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            indeterminate: true;
        }
        Rectangle {
            horizontal-stretch: 1;
            // While Remove asks to confirm: Esc cancels, Enter removes (macOS
            // confirmationDialog). Kept out of the layouts so it takes no room.
            remove-keys := FocusScope {
                enabled: root.confirming-remove;
                width: 0px;
                height: 0px;
                key-pressed(e) => {
                    if e.text == Key.Escape {
                        root.confirming-remove = false;
                        return accept;
                    }
                    if e.text == Key.Return {
                        root.confirming-remove = false;
                        root.remove();
                        return accept;
                    }
                    reject
                }
            }
        }
        if root.data.switch-state != "" && root.data.switch-state != "active": ActionButton {
            label: "Switch";
            glyph: "\u{E8AB}";
            enabled: !root.cc-switching;
            tip: root.data.switch-help;
            y: (parent.height - self.height) / 2;
            clicked => { root.switch-cc(); }
        }
        if root.data.switch-state == "active" && root.desktop-differs: ActionButton {
            label: "Switch Desktop to this account";
            glyph: "\u{E7F4}";
            enabled: !root.desktop-switching;
            tip: "Claude Desktop uses another account than Claude Code. Asks before closing Desktop.";
            y: (parent.height - self.height) / 2;
            clicked => { root.switch-desktop(); }
        }
        ActionButton {
            label: "Refresh";
            glyph: "\u{E72C}";
            enabled: !root.refreshing && !root.data.expired;
            tip: root.data.expired
                ? "Session expired. Re-sync to read a fresh key from the browser."
                : "Fetch the latest usage for this account";
            y: (parent.height - self.height) / 2;
            clicked => { root.refresh(); }
        }
    }

    Flickable {
        vertical-stretch: 1;
        content-height: body.preferred-height;
        body := VerticalLayout {
            spacing: 20px;
            alignment: start;

            PaneSection {
                HorizontalLayout {
                    spacing: 14px;
                    Avatar { size: 56px; initial: root.data.initial; tint: root.data.avatar-color; y: (parent.height - self.height) / 2; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: root.data.name;
                                color: Theme.text-primary;
                                font-size: 17px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if root.data.claude-code: Rectangle {
                                width: 8px; height: 8px; y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: Theme.ok;
                                Tooltip { text: @markdown("Currently active in Claude Code"); }
                            }
                            Rectangle {
                                width: plan.preferred-width + 12px;
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 10px;
                                background: root.plan-tint.with-alpha(0.15);
                                plan := Text {
                                    text: root.data.plan;
                                    color: Theme.text-primary;
                                    font-size: 10px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.data.email != "" && root.data.email != root.data.name: Text {
                            text: root.data.email;
                            color: Theme.text-secondary;
                            overflow: elide;
                        }
                        // Status line: expired guidance, else the last error.
                        if root.data.expired: HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: "\u{E7BA}";
                                font-family: "Segoe Fluent Icons";
                                color: #ff9f0a;
                                vertical-alignment: center;
                            }
                            Text { text: "Session expired"; color: #ff9f0a; vertical-alignment: center; }
                        }
                        if root.data.expired && root.data.expired-hint != "": Text {
                            text: root.data.expired-hint;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        if root.data.expired: HorizontalLayout {
                            alignment: start;
                            ActionButton {
                                label: "Re-sync"; height: 26px;
                                tip: "Read a fresh session key from the browser";
                                clicked => { root.resync(); }
                            }
                        }
                        if root.data.error != "": Text {
                            text: root.data.error;
                            color: Theme.danger;
                            wrap: word-wrap;
                        }
                        if !root.data.expired && root.data.error == "": Text {
                            text: root.data.staleness;
                            color: Theme.text-secondary;
                            font-size: 11px;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // macOS: no usage yet reads "No usage data yet."
                    if !root.data.expired && root.data.error == ""
                        && !root.data.five-hour.present && !root.data.seven-day.present: Text {
                        text: "No usage data yet.";
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    // macOS shows the gauges whenever there is usage, expired or not.
                    if root.data.five-hour.present || root.data.seven-day.present: UsageGaugeRow {
                        data: root.data;
                        open-window(w) => { root.open-window(w); }
                    }
                }
            }

            if root.active: HistoryBox {
                window-picked(w) => { root.window-picked(w); }
            }

            PaneSection {
                title: "Actions";
                ActionRow {
                    title: "Pin to Top";
                    PaneSwitch {
                        checked: root.data.pinned;
                        y: (parent.height - self.height) / 2;
                        toggled => { root.toggle-pin(!root.data.pinned); }
                    }
                }
                if root.data.shows-home: Rectangle { height: 1px; background: Theme.card-border; }
                if root.data.shows-home: ActionRow {
                    title: "Switch here after 5h reset";
                    PaneSwitch {
                        checked: root.data.is-home;
                        y: (parent.height - self.height) / 2;
                        toggled => { root.toggle-home(); }
                        Tooltip { text: @markdown("Switch Claude Code back to this account each time its 5h limit resets"); }
                    }
                }
                Rectangle { height: 1px; background: Theme.card-border; }
                // macOS: "Start the 5h window now" with Ping, the latest ping under it.
                ActionRow {
                    title: "Start the 5h window now";
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        HorizontalLayout {
                            alignment: end;
                            spacing: 6px;
                            if root.data.pinging: Spinner {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                indeterminate: true;
                            }
                            ActionButton {
                                label: "Ping";
                                enabled: !root.data.pinging && root.data.status == "Active";
                                tip: "Send one short message from this account to start its 5h and 7d windows";
                                clicked => { root.ping(); }
                            }
                        }
                        if root.data.ping-caption != "": Text {
                            text: root.data.ping-caption;
                            color: root.data.ping-failed ? Theme.danger : Theme.text-secondary;
                            font-size: 11px;
                            horizontal-alignment: right;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.card-border; }
                ActionRow {
                    title: "Read a fresh session key from the browser";
                    ActionButton {
                        label: "Re-sync";
                        tip: "Read a fresh session key from the browser";
                        clicked => { root.resync(); }
                    }
                }
                Rectangle { height: 1px; background: Theme.card-border; }
                ActionRow {
                    title: root.confirming-remove ? "Remove " + root.data.name + "?" : "Remove this account from the dashboard";
                    spacing: 8px;
                    if !root.confirming-remove: ActionButton {
                        label: "Remove Account\u{2026}"; tint: Theme.danger;
                        tip: "Remove this account from the dashboard";
                        clicked => {
                            root.confirming-remove = true;
                            remove-keys.focus();
                        }
                    }
                    if root.confirming-remove: ActionButton {
                        label: "Remove Account"; tint: Theme.danger;
                        clicked => { root.confirming-remove = false; root.remove(); }
                    }
                    if root.confirming-remove: ActionButton {
                        label: "Cancel"; tint: Theme.text-secondary;
                        clicked => { root.confirming-remove = false; }
                    }
                }
            }
        }
    }
}
