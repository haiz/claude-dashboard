import { SidebarRow, AccountCard, AccountPane, UsageGauge, Avatar } from "components.slint";
import { Theme, UiRow, UiWindow } from "theme.slint";
import { SetupWizardWindow, ScanItem } from "wizard.slint";
export { Theme, UiRow, UiWindow, SetupWizardWindow, ScanItem }

// Pane selection. `account` is the per-account page (see selected-account-id).
export enum Pane { dashboard, overview, account, command-log, help, settings-accounts, general }

component GroupHeader inherits Text {
    color: Theme.text-secondary;
    font-size: 12px;
    font-weight: 600;
}

// Shown in the Dashboard pane and the flyout when no accounts exist. The
// button opens the Add Account wizard.
component EmptyState inherits VerticalLayout {
    callback add-account();
    alignment: center;
    spacing: 10px;
    Text { text: "No accounts yet"; color: Theme.text-primary; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
    Text { text: "Add an account to start tracking usage."; color: Theme.text-secondary; horizontal-alignment: center; wrap: word-wrap; }
    HorizontalLayout {
        alignment: center;
        Rectangle {
            height: 32px;
            width: add-text.preferred-width + 28px;
            border-radius: 6px;
            background: add-touch.has-hover ? Theme.accent.with-alpha(0.15) : Theme.card-bg;
            border-width: 1px;
            border-color: Theme.card-border;
            add-text := Text { text: "Add Account"; color: Theme.accent; horizontal-alignment: center; vertical-alignment: center; }
            add-touch := TouchArea { clicked => { root.add-account(); } }
        }
    }
}

export component AppWindow inherits Window {
    title: "Claude Dashboard";
    min-width: 640px;
    min-height: 400px;
    preferred-width: 960px;
    preferred-height: 660px;
    default-font-family: Theme.font-family;
    default-font-size: 14px;
    // Transparent so Mica shows through; the solid fill below is used only
    // when Mica is unavailable (Windows 10).
    background: transparent;
    in property <bool> use-solid-background: false;
    in property <[UiRow]> account-rows;
    in-out property <Pane> selection: Pane.dashboard;
    in-out property <string> selected-account-id;
    callback resync();
    callback add-account();

    property <string> pane-title: root.selection == Pane.dashboard ? "Dashboard"
        : root.selection == Pane.overview ? "Overview"
        : root.selection == Pane.command-log ? "Command Log"
        : root.selection == Pane.help ? "Help"
        : root.selection == Pane.settings-accounts ? "Accounts"
        : root.selection == Pane.general ? "General"
        : "Account";

    Rectangle {
        background: root.use-solid-background ? Theme.window-bg : transparent;
    }

    HorizontalLayout {
        // Sidebar
        Rectangle {
            width: 240px;
            background: Theme.dark ? #ffffff08 : #ffffff80;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.card-border;
            }
            Flickable {
                content-height: side.preferred-height;
                side := VerticalLayout {
                    padding: 12px;
                    spacing: 2px;
                    alignment: start;

                    GroupHeader { text: "Usage"; }
                    SidebarRow {
                        label: "Dashboard"; glyph: "\u{E80A}"; tile: #0a84ff;
                        text-color: Theme.text-primary;
                        selected: root.selection == Pane.dashboard;
                        clicked => { root.selection = Pane.dashboard; }
                    }
                    SidebarRow {
                        label: "Overview"; glyph: "\u{E9D2}"; tile: #ff9f0a;
                        text-color: Theme.text-primary; enabled: false;
                    }

                    GroupHeader { text: "Accounts"; }
                    for acct in root.account-rows: SidebarRow {
                        label: acct.name; initial: acct.initial; tile: acct.avatar-color;
                        text-color: Theme.text-primary;
                        selected: root.selection == Pane.account && root.selected-account-id == acct.id;
                        clicked => {
                            root.selected-account-id = acct.id;
                            root.selection = Pane.account;
                        }
                    }

                    GroupHeader { text: "Tools"; }
                    SidebarRow {
                        label: "Command Log"; glyph: "\u{E756}"; tile: #5e5ce6;
                        text-color: Theme.text-primary; enabled: false;
                    }
                    SidebarRow {
                        label: "Help"; glyph: "\u{E897}"; tile: #30d158;
                        text-color: Theme.text-primary; enabled: false;
                    }

                    GroupHeader { text: "Settings"; }
                    SidebarRow {
                        label: "Accounts"; glyph: "\u{E77B}"; tile: #40c8e0;
                        text-color: Theme.text-primary; enabled: false;
                    }
                    SidebarRow {
                        label: "General"; glyph: "\u{E713}"; tile: #8e8e93;
                        text-color: Theme.text-primary; enabled: false;
                    }
                }
            }
        }

        // Content
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text {
                text: root.pane-title;
                color: Theme.text-primary;
                font-size: 24px;
                font-weight: 600;
            }
            if root.selection == Pane.account: Rectangle {
                // Non-layout container: one pane per row, only the selected one visible.
                for acct in root.account-rows: AccountPane {
                    visible: root.selected-account-id == acct.id;
                    data: acct;
                    width: parent.width;
                    height: parent.height;
                    resync => { root.resync(); }
                }
            }
            if root.selection == Pane.dashboard && root.account-rows.length == 0: EmptyState {
                vertical-stretch: 1;
                add-account => { root.add-account(); }
            }
            if root.selection != Pane.account && root.selection != Pane.dashboard: Text {
                text: "Coming soon.";
                color: Theme.text-secondary;
            }
            if root.selection == Pane.dashboard: Flickable {
                // Responsive wrap: as many fixed-width cards per row as fit.
                property <length> card-w: 300px;
                property <length> card-h: 280px;
                property <length> gap: 14px;
                property <int> cols: max(1, floor((self.width + self.gap) / (self.card-w + self.gap)));
                property <int> nrows: ceil(root.account-rows.length / self.cols);
                content-height: self.nrows * (self.card-h + self.gap);
                for acct[i] in root.account-rows: AccountCard {
                    data: acct;
                    x: mod(i, parent.cols) * (parent.card-w + parent.gap);
                    y: floor(i / parent.cols) * (parent.card-h + parent.gap);
                    width: parent.card-w;
                    height: parent.card-h;
                    clicked => {
                        root.selected-account-id = acct.id;
                        root.selection = Pane.account;
                    }
                }
            }
            if root.selection != Pane.dashboard: Rectangle { }
        }
    }
}


component FlyoutIconButton inherits Rectangle {
    in property <string> glyph;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.accent.with-alpha(0.15) : transparent;
    Text {
        text: root.glyph;
        font-family: "Segoe Fluent Icons";
        font-size: 14px;
        color: Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// Tray flyout (macOS MenuBarPopover): header, compact account rows, footer.
// Borderless; Rust applies Mica + rounded corners and places it at the tray.
export component PopoverWindow inherits Window {
    no-frame: true;
    width: 340px;
    height: 420px;
    default-font-family: Theme.font-family;
    default-font-size: 14px;
    background: transparent;
    in property <bool> use-solid-background: false;
    in property <[UiRow]> account-rows;
    callback expand();
    callback refresh();
    callback quit();
    callback add-account();

    Rectangle {
        background: root.use-solid-background ? Theme.window-bg : (Theme.dark ? #20202080 : #f3f3f380);
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: "Claude Dashboard";
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { }
            FlyoutIconButton { glyph: "\u{E72C}"; clicked => { root.refresh(); } }
            FlyoutIconButton { glyph: "\u{E740}"; clicked => { root.expand(); } }
        }
        if root.account-rows.length == 0: EmptyState { vertical-stretch: 1; add-account => { root.add-account(); } }
        Flickable {
            content-height: list.preferred-height;
            list := VerticalLayout {
                spacing: 6px;
                alignment: start;
                for acct in root.account-rows: Rectangle {
                    height: 60px;
                    background: Theme.card-bg;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 10px;
                        Avatar { size: 32px; initial: acct.initial; tint: acct.avatar-color; y: (parent.height - self.height) / 2; }
                        VerticalLayout {
                            alignment: center;
                            Text { text: acct.name; color: Theme.text-primary; font-weight: 600; overflow: elide; }
                            Text {
                                text: acct.error != "" ? acct.error : acct.plan;
                                color: acct.error != "" ? Theme.danger : Theme.text-secondary;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                        if acct.five-hour.present: UsageGauge { win: acct.five-hour; zoom: 0.55; y: (parent.height - self.height) / 2; }
                        if acct.seven-day.present: UsageGauge { win: acct.seven-day; zoom: 0.55; y: (parent.height - self.height) / 2; }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: space-between;
            Rectangle {
                height: 32px;
                width: expand-text.preferred-width + 28px;
                border-radius: 6px;
                background: expand-touch.has-hover ? Theme.accent.with-alpha(0.15) : Theme.card-bg;
                border-width: 1px;
                border-color: Theme.card-border;
                expand-text := Text { text: "Expand"; color: Theme.accent; horizontal-alignment: center; vertical-alignment: center; }
                expand-touch := TouchArea { clicked => { root.expand(); } }
            }
            Rectangle {
                height: 32px;
                width: quit-text.preferred-width + 28px;
                border-radius: 6px;
                background: quit-touch.has-hover ? Theme.danger.with-alpha(0.15) : transparent;
                quit-text := Text { text: "Quit"; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                quit-touch := TouchArea { clicked => { root.quit(); } }
            }
        }
    }
}
