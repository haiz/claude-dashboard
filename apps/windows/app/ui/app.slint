// Color tokens shared by all windows/components. `dark` is driven from Rust
// (or the system scheme); light values are the default.
export global Theme {
    in property <bool> dark: false;

    out property <color> window-bg: dark ? #202020 : #f3f3f3;
    out property <color> card-bg: dark ? #2b2b2b : #ffffff;
    out property <color> card-border: dark ? #3a3a3a : #e5e5e5;
    out property <color> text-primary: dark ? #ffffff : #1a1a1a;
    out property <color> text-secondary: dark ? #c5c5c5 : #5f5f5f;
    out property <color> accent: dark ? #60cdff : #0067c0;
    out property <color> ok: dark ? #6ccb5f : #107c10;
    out property <color> warn: dark ? #fce100 : #9d5d00;
    out property <color> danger: dark ? #ff99a4 : #c42b1c;

    out property <string> font-family: "Segoe UI Variable";
}

export component AppWindow inherits Window {
    title: "Claude Dashboard";
    min-width: 480px;
    min-height: 360px;
    preferred-width: 900px;
    preferred-height: 640px;
    default-font-family: Theme.font-family;
    default-font-size: 14px;
    // Transparent so Mica shows through; the solid fill below is used only
    // when Mica is unavailable (Windows 10).
    background: transparent;
    in property <bool> use-solid-background: false;

    Rectangle {
        background: root.use-solid-background ? Theme.window-bg : transparent;
    }

    VerticalLayout {
        padding: 24px;
        Text {
            text: "Claude Dashboard";
            color: Theme.text-primary;
            font-size: 24px;
            font-weight: 600;
        }
        Text {
            text: "Usage data will appear here.";
            color: Theme.text-secondary;
        }
    }
}
