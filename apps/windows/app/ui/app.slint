import { AboutSlint, Spinner } from "std-widgets.slint";
import { SidebarRow, AccountCard, AccountPane, UsageGauge, Avatar } from "components.slint";
import { Theme, UiRow, UiWindow } from "theme.slint";
import { SetupWizardWindow, ScanItem } from "wizard.slint";
import { OverviewPane, ChartState, ChartTick, ChartLine, ChartLegendItem, ChartPoint, ChartCycle, ChartActions, HistoryData } from "chart.slint";
import { HelpPane, HelpTopic } from "help.slint";
import { InfoTip, TipStore, TipData } from "info_tip.slint";

export { TipStore, TipData, HelpTopic, Theme, UiRow, UiWindow, SetupWizardWindow, ScanItem, ChartState, ChartTick, ChartLine, ChartLegendItem, ChartPoint, ChartCycle, ChartActions, HistoryData }

// Pane selection. `account` is the per-account page (see selected-account-id).
export enum Pane { dashboard, overview, account, help, settings-accounts, general }

component GroupHeader inherits Text {
    color: Theme.text-secondary;
    font-size: 12px;
    font-weight: 600;
}

// A sidebar section title (macOS `.sidebar` list Section header): small, secondary, with
// room above it to split the sections.
component SidebarHeader inherits Rectangle {
    in property <string> text;
    in property <bool> first: false;
    height: root.first ? 22px : 34px;
    Text {
        x: 8px;
        y: parent.height - self.height - 4px;
        text: root.text;
        color: Theme.text-secondary;
        font-size: 11px;
        font-weight: 600;
    }
}

// Shown in the Dashboard pane and the flyout when no accounts exist (macOS
// `emptyStateView` / the popover's `emptyState`): the add-person icon, the title,
// and a filled accent "Add Account" button that opens the Add Account wizard.
// `compact` is the flyout's smaller variant (no subtitle, secondary title).
component EmptyState inherits VerticalLayout {
    in property <string> title: "No Accounts";
    in property <string> subtitle: "Sync your Claude accounts from your browser to get started.";
    in property <string> tip: "Add a Claude account from your browser or a pasted session key";
    in property <bool> compact: false;
    callback add-account();
    alignment: center;
    spacing: root.compact ? 12px : 16px;
    Text {
        text: "\u{E8FA}";
        font-family: "Segoe Fluent Icons";
        font-size: root.compact ? 26px : 48px;
        color: Theme.text-secondary;
        horizontal-alignment: center;
    }
    Text {
        text: root.title;
        color: root.compact ? Theme.text-secondary : Theme.text-primary;
        font-size: root.compact ? 12px : 15px;
        font-weight: root.compact ? 400 : 700;
        horizontal-alignment: center;
    }
    if root.subtitle != "": Text { text: root.subtitle; color: Theme.text-secondary; horizontal-alignment: center; wrap: word-wrap; }
    HorizontalLayout {
        alignment: center;
        Rectangle {
            height: root.compact ? 28px : 32px;
            width: add-text.preferred-width + 28px;
            border-radius: 6px;
            background: add-touch.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
            add-text := Text {
                text: "Add Account";
                color: #ffffff;
                font-size: root.compact ? 12px : 14px;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            add-touch := TouchArea { mouse-cursor: pointer; clicked => { root.add-account(); } }
            Tooltip { text: @markdown("\{root.tip}"); }
        }
    }
}

component PaneButton inherits Rectangle {
    in property <string> label;
    in property <color> tint: Theme.accent;
    in property <bool> enabled: true;
    // Hover tooltip (macOS `.help`); empty shows none.
    in property <string> tip;
    // Optional Segoe Fluent glyph before the label (macOS `Label(_, systemImage:)`).
    in property <string> glyph;
    // The default action (macOS `.borderedProminent` / `.defaultAction`): filled accent.
    in property <bool> prominent: false;
    callback clicked();
    height: 32px;
    width: row.preferred-width + 28px;
    border-radius: 6px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.prominent
        ? (touch.has-hover ? Theme.accent.darker(0.1) : Theme.accent)
        : (touch.has-hover && root.enabled ? root.tint.with-alpha(0.15) : Theme.card-bg);
    border-width: root.prominent ? 0px : 1px;
    border-color: Theme.card-border;
    property <color> fg: root.prominent ? #ffffff : (root.enabled ? root.tint : Theme.text-secondary);
    row := HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2;
        width: self.preferred-width;
        spacing: 6px;
        if root.glyph != "": Text {
            text: root.glyph;
            font-family: "Segoe Fluent Icons";
            font-size: 13px;
            color: root.fg;
            vertical-alignment: center;
        }
        Text { text: root.label; color: root.fg; vertical-alignment: center; }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

// Settings > Accounts (macOS AccountsSettingsPane): the account list with trash buttons,
// Add Account and Re-sync All under it, and the muted extension sources.
component AccountsSettingsPane inherits VerticalLayout {
    in property <[UiRow]> rows;
    in property <[string]> muted;
    in property <string> resync-progress;
    in property <bool> resyncing;
    callback add-account();
    callback resync();
    callback delete-account(string);
    callback unmute(string);
    spacing: 12px;

    Flickable {
        content-height: list.preferred-height;
        list := VerticalLayout {
            spacing: 8px;
            alignment: start;
            // macOS grouped Form section: one box, rows split by dividers.
            Rectangle {
                height: rows-box.preferred-height;
                background: Theme.card-bg;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.card-border;
                rows-box := VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    if root.rows.length == 0: Text {
                        height: 40px;
                        text: "No accounts yet.";
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    for acct[i] in root.rows: VerticalLayout {
                        if i > 0: Rectangle { height: 1px; background: Theme.card-border; }
                        HorizontalLayout {
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 10px;
                            Avatar { size: 28px; initial: acct.initial; tint: acct.avatar-color; y: (parent.height - self.height) / 2; }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text { text: acct.name; color: Theme.text-primary; overflow: elide; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    // Plan capsule in the secondary tint, then where the key comes from.
                                    Rectangle {
                                        width: plan-text.preferred-width + 12px;
                                        height: 16px;
                                        border-radius: 8px;
                                        background: Theme.text-secondary.with-alpha(0.15);
                                        plan-text := Text { text: acct.plan; color: Theme.text-primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: acct.kind-label; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            if acct.expired: Rectangle {
                                width: warn.preferred-width;
                                warn := Text {
                                    height: parent.height;
                                    text: "\u{E7BA}";
                                    font-family: "Segoe Fluent Icons";
                                    font-size: 14px;
                                    color: #ff9f0a;
                                    vertical-alignment: center;
                                }
                                Tooltip { text: @markdown("Session expired"); }
                            }
                            // macOS removes at once from the red trash button.
                            Rectangle {
                                width: 28px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 5px;
                                background: trash.has-hover ? Theme.text-primary.with-alpha(0.10) : transparent;
                                Text {
                                    text: "\u{E74D}";
                                    font-family: "Segoe Fluent Icons";
                                    font-size: 14px;
                                    color: Theme.danger;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                trash := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.delete-account(acct.id); }
                                }
                                Tooltip { text: @markdown("Remove account"); }
                            }
                        }
                    }
                }
            }
            // Section footer, right-aligned (System Settings list actions).
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                PaneButton {
                    label: "Add Account\u{2026}";
                    tip: "Add a Claude account from your browser or a pasted session key";
                    clicked => { root.add-account(); }
                }
                PaneButton {
                    label: root.resyncing ? root.resync-progress : "Re-sync All";
                    enabled: !root.resyncing && root.rows.length > 0;
                    tip: "Read fresh session keys from the browser for every account";
                    clicked => { root.resync(); }
                }
            }
            if root.muted.length > 0: GroupHeader { text: "Muted sources"; }
            if root.muted.length > 0: Text {
                text: "Browser-extension installs whose account was deleted. Unmute to let them add accounts again.";
                color: Theme.text-secondary; font-size: 11px; wrap: word-wrap;
            }
            for inst in root.muted: Rectangle {
                height: 44px;
                background: Theme.card-bg;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.card-border;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 10px;
                    Text { text: inst; color: Theme.text-primary; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    PaneButton { label: "Unmute"; y: (parent.height - self.height) / 2; clicked => { root.unmute(inst); } }
                }
            }
        }
    }
}

component SettingsCard inherits Rectangle {
    background: Theme.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-border;
}

// Pill switch used by the Settings > General rows.
component SwitchKnob inherits Rectangle {
    in property <bool> on;
    callback toggled(bool);
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent : Theme.card-border;
    Rectangle {
        width: 16px; height: 16px; border-radius: 8px; background: #ffffff;
        y: 3px;
        x: root.on ? parent.width - self.width - 3px : 3px;
    }
    TouchArea { clicked => { root.toggled(!root.on); } }
}

// Square stepper button for the Auto Refresh interval.
component StepButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    callback clicked();
    width: 26px;
    height: 24px;
    border-radius: 5px;
    border-width: 1px;
    border-color: Theme.card-border;
    opacity: root.enabled ? 1.0 : 0.4;
    background: touch.has-hover && root.enabled ? Theme.accent.with-alpha(0.15) : transparent;
    Text { text: root.glyph; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// Settings > General (macOS GeneralSettingsPane): About, Auto Refresh (switch + 1-60 min
// stepper), Launch at startup, Updates, Reset All Settings.
component GeneralSettingsPane inherits Flickable {
    in property <string> app-name;
    in property <string> app-version;
    in property <string> release-date;
    in property <bool> auto-refresh-enabled;
    in property <int> auto-refresh-minutes;
    in property <bool> launch-at-startup;
    callback set-auto-refresh-enabled(bool);
    callback set-auto-refresh-minutes(int);
    callback set-launch-at-startup(bool);
    in property <string> update-status;
    // 2 error (red), 1 up to date (green), 0 other (secondary).
    in property <int> update-status-kind;
    in property <string> update-latest;
    // False in dev builds: Check for Updates is disabled, as in macOS debug builds.
    in property <bool> update-release;
    in property <bool> update-busy;
    in property <bool> auto-update;
    callback check-updates();
    callback set-auto-update(bool);
    callback reset-all-settings();
    property <bool> confirming-reset;
    content-height: col.preferred-height;
    col := VerticalLayout {
        spacing: 12px;
        alignment: start;

        SettingsCard {
            height: about-col.preferred-height + 24px;
            about-col := VerticalLayout {
                padding: 12px;
                spacing: 4px;
                // macOS About: the 64 pt app icon, the name, version and release date.
                HorizontalLayout {
                    alignment: center;
                    Image { source: @image-url("assets/app-icon.png"); width: 64px; height: 64px; }
                }
                Text { text: root.app-name; color: Theme.text-primary; font-size: 17px; font-weight: 700; horizontal-alignment: center; }
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text { text: "Version " + root.app-version; color: Theme.text-secondary; }
                    if root.release-date != "": Text {
                        text: "(" + root.release-date + ")";
                        color: Theme.text-secondary; font-size: 11px; vertical-alignment: bottom;
                    }
                }
                // Windows-only: the Slint royalty-free licence asks for this attribution.
                AboutSlint { height: 120px; }
            }
        }

        GroupHeader { text: "Auto Refresh"; }
        SettingsCard {
            height: ar.preferred-height + 24px;
            ar := VerticalLayout {
                padding: 12px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 4px;
                    Text { text: "Enable auto refresh"; color: Theme.text-primary; vertical-alignment: center; }
                    InfoTip { tip-id: "auto-refresh"; y: (parent.height - self.height) / 2; }
                    Rectangle { horizontal-stretch: 1; }
                    SwitchKnob { on: root.auto-refresh-enabled; toggled(v) => { root.set-auto-refresh-enabled(v); } }
                }
                if root.auto-refresh-enabled: HorizontalLayout {
                    spacing: 4px;
                    Text { text: "Interval"; color: Theme.text-primary; vertical-alignment: center; }
                    InfoTip { tip-id: "refresh-interval"; y: (parent.height - self.height) / 2; }
                    Rectangle { horizontal-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        StepButton {
                            glyph: "\u{2212}";
                            enabled: root.auto-refresh-minutes > 1;
                            clicked => { root.set-auto-refresh-minutes(root.auto-refresh-minutes - 1); }
                        }
                        Text { text: root.auto-refresh-minutes + " min"; color: Theme.text-primary; vertical-alignment: center; horizontal-alignment: center; min-width: 52px; }
                        StepButton {
                            glyph: "+";
                            enabled: root.auto-refresh-minutes < 60;
                            clicked => { root.set-auto-refresh-minutes(root.auto-refresh-minutes + 1); }
                        }
                    }
                }
            }
        }

        GroupHeader { text: "Startup"; }
        SettingsCard {
            height: 52px;
            HorizontalLayout {
                padding: 12px;
                Text { text: "Launch at startup"; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                SwitchKnob { y: (parent.height - self.height) / 2; on: root.launch-at-startup; toggled(v) => { root.set-launch-at-startup(v); } }
            }
        }

        GroupHeader { text: "Updates"; }
        SettingsCard {
            height: upd.preferred-height + 24px;
            upd := VerticalLayout {
                padding: 12px;
                spacing: 10px;
                // macOS order: the toggle, Latest version, Status, then Check for Updates.
                HorizontalLayout {
                    spacing: 4px;
                    Text { text: "Auto-update daily"; color: Theme.text-primary; vertical-alignment: center; }
                    InfoTip { tip-id: "auto-update"; y: (parent.height - self.height) / 2; }
                    Rectangle { horizontal-stretch: 1; }
                    SwitchKnob { on: root.auto-update; toggled(v) => { root.set-auto-update(v); } }
                }
                if root.update-latest != "": HorizontalLayout {
                    Text { text: "Latest version"; color: Theme.text-primary; horizontal-stretch: 1; }
                    Text { text: "v" + root.update-latest; color: Theme.text-secondary; }
                }
                if root.update-status != "": HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Status"; color: Theme.text-primary; }
                    Text {
                        text: root.update-status;
                        color: root.update-status-kind == 2 ? Theme.danger : root.update-status-kind == 1 ? Theme.ok : Theme.text-secondary;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    PaneButton {
                        label: root.update-busy ? "Working\u{2026}" : "Check for Updates";
                        tint: Theme.text-primary;
                        enabled: root.update-release && !root.update-busy;
                        tip: root.update-release ? "Check GitHub for a newer version and install it" : "Updates only run in release builds";
                        clicked => { root.check-updates(); }
                    }
                }
            }
        }
        if root.auto-update: Text {
            text: "Checks GitHub once a day and installs new releases automatically.";
            color: Theme.text-secondary; font-size: 11px;
        }

        SettingsCard {
            height: rst.preferred-height + 24px;
            // While the reset asks to confirm: Esc cancels, Enter resets (macOS dialog keys).
            reset-keys := FocusScope {
                enabled: root.confirming-reset;
                width: 0px;
                height: 0px;
                key-pressed(e) => {
                    if e.text == Key.Escape {
                        root.confirming-reset = false;
                        return accept;
                    }
                    if e.text == Key.Return {
                        root.confirming-reset = false;
                        root.reset-all-settings();
                        return accept;
                    }
                    reject
                }
            }
            rst := VerticalLayout {
                padding: 12px;
                spacing: 8px;
                if !root.confirming-reset: HorizontalLayout {
                    alignment: end;
                    PaneButton {
                        label: "Reset All Settings\u{2026}"; tint: Theme.danger;
                        tip: "Restore every setting on this page to its default";
                        clicked => {
                            root.confirming-reset = true;
                            reset-keys.focus();
                        }
                    }
                }
                if root.confirming-reset: Text {
                    text: "Reset all settings to their defaults?";
                    color: Theme.text-primary; font-weight: 600; wrap: word-wrap;
                }
                if root.confirming-reset: Text {
                    text: "Auto refresh and Updates go back to their defaults.";
                    color: Theme.text-secondary; font-size: 12px; wrap: word-wrap;
                }
                if root.confirming-reset: HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PaneButton { label: "Cancel"; tint: Theme.text-secondary; clicked => { root.confirming-reset = false; } }
                    PaneButton { label: "Reset All Settings"; tint: Theme.danger; clicked => { root.confirming-reset = false; root.reset-all-settings(); } }
                }
            }
        }
        Text { text: "Accounts, logs and Launch at startup are kept."; color: Theme.text-secondary; font-size: 11px; }
    }
}

export component AppWindow inherits Window {
    title: "Claude Dashboard";
    min-width: 900px;
    min-height: 560px;
    preferred-width: 1200px;
    preferred-height: 800px;
    default-font-family: Theme.font-family;
    default-font-size: 14px;
    // Transparent so Mica shows through; the solid fill below is used only
    // when Mica is unavailable (Windows 10).
    background: transparent;
    in property <bool> use-solid-background: false;
    in property <[UiRow]> account-rows;
    // The same rows in a stable order (a re-sort never moves them), so the account
    // pages' components, and their local state, survive a refresh. Set from Rust.
    in property <[UiRow]> pane-rows;
    in-out property <Pane> selection: Pane.dashboard;
    in-out property <string> selected-account-id;
    // Help pane: the topic grid, and the topic id to scroll to ("" = top). `open-help` selects
    // the pane and sets the focus; the pane clears it once it has scrolled.
    in property <[HelpTopic]> help-topics;
    in property <UiWindow> help-sample;
    in-out property <string> help-focus;
    public function open-help(topic: string) {
        root.selection = Pane.help;
        root.help-focus = topic;
    }
    callback resync();
    callback resync-all();
    // True while a refresh runs (any scope); Rust raises it with the card spinners.
    in property <bool> refreshing: false;
    // Settings > Accounts Re-sync All: "Re-syncing… (n/total)" while running, else empty.
    in property <string> resync-progress;
    in property <bool> resyncing;
    // Account card and account page actions (ids are account ids).
    callback toggle-pin(string, bool);
    callback resync-account(string);
    // Refresh one account only (the account page header).
    callback refresh-account(string);
    // Remove an account (the account page Actions box); same path as Settings > Accounts delete.
    callback remove-account(string);
    // An account page was opened (sidebar row, card, flyout); the chart window resets to 5h.
    callback select-account(string);
    // A gauge click: "5h" | "7d" | "fable". The pane is selected here; the chart reads
    // `requested-window` to pick its window.
    callback open-account-window(string, string);
    in-out property <string> requested-window;
    in property <[string]> muted-sources;
    callback delete-account(string);
    callback unmute(string);
    callback add-account();

    in-out property <ChartState> overview;
    callback overview-open();
    callback overview-close();
    callback overview-window(string);
    callback overview-preset(string);
    callback overview-toggle(string);
    callback overview-size(float, float);
    callback overview-hover(float, float);
    callback overview-select(float, float);
    callback overview-pan(float);
    callback overview-toggle-mode();
    callback overview-reset();
    changed selection => {
        if root.selection == Pane.overview { root.overview-open(); } else { root.overview-close(); }
    }
    // The account page's History chart: opened with the page's account and the requested
    // window (a gauge click, the History window picker, or "5h" from a sidebar click) and
    // closed (empty key) when the page is left. One key, so a burst of property writes
    // (select account, then requested window) opens the chart once with the final values.
    property <string> chart-key: root.selection == Pane.account && root.selected-account-id != ""
        ? root.selected-account-id + "|" + root.requested-window : "";
    changed chart-key => {
        if root.chart-key == "" {
            ChartActions.open("", "");
        } else {
            ChartActions.open(root.selected-account-id, root.requested-window);
        }
    }

    in property <string> app-name;
    in property <string> app-version;
    in property <string> release-date;
    in-out property <bool> auto-refresh-enabled: true;
    in-out property <int> auto-refresh-minutes: 5;
    in-out property <bool> launch-at-startup;
    callback set-auto-refresh-enabled(bool);
    callback set-auto-refresh-minutes(int);
    callback reset-all-settings();
    callback set-launch-at-startup(bool);
    in property <string> update-status;
    in property <int> update-status-kind;
    in property <string> update-latest;
    in property <bool> update-release;
    in property <bool> update-busy;
    in-out property <bool> auto-update: true;
    callback check-updates();
    callback set-auto-update(bool);

    // Opens an account's page on the 5h window (macOS `selectFromSidebar` resets the window).
    function select-account-page(id: string) {
        root.requested-window = "5h";
        root.selected-account-id = id;
        root.selection = Pane.account;
        root.select-account(id);
    }

    property <string> pane-title: root.selection == Pane.dashboard ? "Dashboard"
        : root.selection == Pane.overview ? "Overview"
        : root.selection == Pane.help ? "Help"
        : root.selection == Pane.settings-accounts ? "Accounts"
        : root.selection == Pane.general ? "General"
        : "Account";

    Rectangle {
        background: root.use-solid-background ? Theme.window-bg : transparent;
    }

    HorizontalLayout {
        // Sidebar
        Rectangle {
            width: 240px;
            background: Theme.dark ? #ffffff08 : #ffffff80;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.card-border;
            }
            Flickable {
                content-height: side.preferred-height;
                side := VerticalLayout {
                    padding: 12px;
                    spacing: 2px;
                    alignment: start;

                    SidebarHeader { text: "Usage"; first: true; }
                    SidebarRow {
                        label: "Dashboard"; glyph: "\u{E80A}"; tile: #0a84ff;
                        text-color: Theme.text-primary;
                        selected: root.selection == Pane.dashboard;
                        clicked => { root.selection = Pane.dashboard; }
                    }
                    SidebarRow {
                        label: "Overview"; glyph: "\u{E9D2}"; tile: #ff9f0a;
                        text-color: Theme.text-primary;
                        selected: root.selection == Pane.overview;
                        clicked => { root.selection = Pane.overview; }
                    }

                    if root.account-rows.length > 0: SidebarHeader { text: "Accounts"; }
                    for acct in root.account-rows: SidebarRow {
                        label: acct.name; initial: acct.initial; tile: acct.avatar-color;
                        text-color: Theme.text-primary;
                        warning: acct.expired;
                        trailing: acct.has-sidebar-percent ? floor(acct.sidebar-percent) + "%" : "";
                        trailing-color: acct.sidebar-color;
                        selected: root.selection == Pane.account && root.selected-account-id == acct.id;
                        clicked => { root.select-account-page(acct.id); }
                    }

                    SidebarHeader { text: "Tools"; }
                    SidebarRow {
                        label: "Help"; glyph: "\u{E897}"; tile: #30d158;
                        text-color: Theme.text-primary;
                        selected: root.selection == Pane.help;
                        clicked => { root.selection = Pane.help; }
                    }

                    SidebarHeader { text: "Settings"; }
                    SidebarRow {
                        label: "Accounts"; glyph: "\u{E77B}"; tile: #40c8e0;
                        text-color: Theme.text-primary;
                        selected: root.selection == Pane.settings-accounts;
                        clicked => { root.selection = Pane.settings-accounts; }
                    }
                    SidebarRow {
                        label: "General"; glyph: "\u{E713}"; tile: #8e8e93;
                        text-color: Theme.text-primary;
                        selected: root.selection == Pane.general;
                        clicked => { root.selection = Pane.general; }
                    }
                }
            }
        }

        // Content
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            // PaneHeader (the account page draws its own, with the account's name).
            if root.selection != Pane.account: HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.pane-title;
                    color: Theme.text-primary;
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.selection == Pane.dashboard && root.account-rows.length > 0: PaneButton {
                    label: "Refresh";
                    glyph: "\u{E72C}";
                    tip: "Refresh usage for all accounts";
                    enabled: !root.refreshing;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.resync(); }
                }
            }
            if root.selection == Pane.account: Rectangle {
                vertical-stretch: 1;
                // Non-layout container: one pane per row, only the selected one visible.
                for acct in root.pane-rows: AccountPane {
                    visible: root.selected-account-id == acct.id;
                    active: root.selected-account-id == acct.id;
                    data: acct;
                    refreshing: root.refreshing;
                    width: parent.width;
                    height: parent.height;
                    refresh => { root.refresh-account(acct.id); }
                    resync => { root.resync-account(acct.id); }
                    toggle-pin(pinned) => { root.toggle-pin(acct.id, pinned); }
                    remove => {
                        root.remove-account(acct.id);
                        root.selection = Pane.dashboard;
                    }
                    open-window(w) => { root.requested-window = w; }
                    window-picked(w) => { root.requested-window = w; }
                }
            }
            if root.selection == Pane.dashboard && root.account-rows.length == 0: EmptyState {
                vertical-stretch: 1;
                add-account => { root.add-account(); }
            }
            if root.selection == Pane.dashboard && root.account-rows.length > 0: scroll := Flickable {
                // macOS adaptive grid: columns 420-480 pt wide, 12 pt apart; a row is as tall
                // as its tallest card (cards size themselves).
                property <length> gap: 12px;
                // Width from the window, not from this Flickable: its own width would loop through the grid it sizes.
                property <length> avail: root.width - 240px - 48px;
                property <int> cols: max(1, floor((self.avail + self.gap) / (420px + self.gap)));
                property <int> nrows: ceil(root.account-rows.length / self.cols);
                property <length> card-w: min(480px, (self.avail - (self.cols - 1) * self.gap) / self.cols);
                content-height: grid.preferred-height;
                grid := VerticalLayout {
                    // Explicit so the cards (sized from the window width) are not read back as a size constraint.
                    min-width: 0px;
                    preferred-width: 0px;
                    max-width: 100000px;
                    spacing: scroll.gap;
                    alignment: start;
                    for r in scroll.nrows: HorizontalLayout {
                        spacing: scroll.gap;
                        alignment: start;
                        for c in min(scroll.cols, root.account-rows.length - r * scroll.cols): AccountCard {
                            property <UiRow> acct: root.account-rows[r * scroll.cols + c];
                            data: self.acct;
                            compact: false;
                            width: scroll.card-w;
                            toggle-pin(pinned) => { root.toggle-pin(self.acct.id, pinned); }
                            resync => { root.resync-account(self.acct.id); }
                            open-window(w) => {
                                root.select-account-page(self.acct.id);
                                root.requested-window = w;
                                root.open-account-window(self.acct.id, w);
                            }
                        }
                    }
                }
            }
            if root.selection == Pane.overview: OverviewPane {
                vertical-stretch: 1;
                state: root.overview;
                window(w) => { root.overview-window(w); }
                preset(p) => { root.overview-preset(p); }
                toggle(id) => { root.overview-toggle(id); }
                size-changed(w, h) => { root.overview-size(w, h); }
                hover(x, y) => { root.overview-hover(x, y); }
                select(a, b) => { root.overview-select(a, b); }
                pan(dx) => { root.overview-pan(dx); }
                toggle-mode => { root.overview-toggle-mode(); }
                reset => { root.overview-reset(); }
            }
            if root.selection == Pane.settings-accounts: AccountsSettingsPane {
                vertical-stretch: 1;
                rows: root.account-rows;
                muted: root.muted-sources;
                resync-progress: root.resync-progress;
                resyncing: root.resyncing;
                add-account => { root.add-account(); }
                resync => { root.resync-all(); }
                delete-account(id) => { root.delete-account(id); }
                unmute(id) => { root.unmute(id); }
            }
            if root.selection == Pane.general: GeneralSettingsPane {
                vertical-stretch: 1;
                app-name: root.app-name;
                app-version: root.app-version;
                release-date: root.release-date;
                auto-refresh-enabled: root.auto-refresh-enabled;
                auto-refresh-minutes: root.auto-refresh-minutes;
                launch-at-startup: root.launch-at-startup;
                set-auto-refresh-enabled(on) => { root.set-auto-refresh-enabled(on); }
                set-auto-refresh-minutes(m) => { root.set-auto-refresh-minutes(m); }
                reset-all-settings => { root.reset-all-settings(); }
                set-launch-at-startup(on) => { root.set-launch-at-startup(on); }
                update-status: root.update-status;
                update-status-kind: root.update-status-kind;
                update-latest: root.update-latest;
                update-release: root.update-release;
                update-busy: root.update-busy;
                auto-update: root.auto-update;
                check-updates => { root.check-updates(); }
                set-auto-update(on) => { root.set-auto-update(on); }
            }
            if root.selection == Pane.help: HelpPane { vertical-stretch: 1; avail-width: root.width - 240px - 48px; topics: root.help-topics; sample: root.help-sample; focus-topic <=> root.help-focus; }
            if root.selection != Pane.dashboard && root.selection != Pane.account: Rectangle { }
        }
    }
}


component FlyoutIconButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    // Hover tooltip (macOS `.help`).
    in property <string> tip;
    callback clicked();
    // macOS HeaderIconButton: 24 pt square, caption-size glyph.
    width: 24px;
    height: 24px;
    border-radius: 6px;
    opacity: root.enabled ? 1.0 : 0.4;
    background: touch.has-hover && root.enabled ? Theme.text-primary.with-alpha(0.15) : Theme.text-primary.with-alpha(0.07);
    Text {
        text: root.glyph;
        font-family: "Segoe Fluent Icons";
        font-size: 12px;
        color: Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    Tooltip { text: @markdown("\{root.tip}"); }
}

// Tray flyout (macOS MenuBarPopover + PopoverFooter): update banner, header with icon
// buttons, compact account cards, footer (Quit | version | empty). Borderless; Rust
// applies Mica + rounded corners and places it at the tray. Height follows the card
// count (macOS sizes the popover to its content, list capped and scrolling).
export component PopoverWindow inherits Window {
    no-frame: true;
    width: 352px;
    height: clamp(root.chrome + root.list-h, 240px, 700px);
    default-font-family: Theme.font-family;
    default-font-size: 14px;
    background: transparent;
    in property <bool> use-solid-background: false;
    in property <[UiRow]> account-rows;
    // True while a refresh is running (disables the header Refresh button).
    in property <bool> refreshing: false;
    // Yellow banner text while an update downloads or installs; empty hides it.
    in property <string> update-banner;
    in property <string> app-version;
    // Inline Quit confirmation (macOS `confirmingQuit`); Rust clears it when the flyout hides.
    in-out property <bool> confirming-quit: false;
    callback expand();
    callback refresh();
    callback open-help();
    callback open-settings();
    callback quit();
    callback add-account();
    callback toggle-pin(string, bool);
    callback resync-account(string);
    // A gauge click opens that account's page on its chart window ("5h" | "7d" | "fable").
    callback open-account-window(string, string);

    // The list is as tall as its cards (they size themselves), capped; the empty state has a fixed height.
    property <length> list-h: root.account-rows.length == 0 ? 170px : min(list.preferred-height, 400px);
    // header 24 + 2x12 padding, two full-width dividers, footer 24 + 2x8 padding
    // (+ the full-width banner 26).
    property <length> chrome: 48px + 2px + 40px + (root.update-banner != "" ? 26px : 0px);

    Rectangle {
        background: root.use-solid-background ? Theme.window-bg : (Theme.dark ? #20202080 : #f3f3f380);
    }

    // macOS layout: banner, header (16 x 12 padding), divider, card list (12 padding),
    // divider, footer (16 x 4); the dividers run the full width.
    VerticalLayout {
        if root.update-banner != "": Rectangle {
            height: 26px;
            background: #fce10026;
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                Spinner { width: 14px; height: 14px; y: (parent.height - self.height) / 2; indeterminate: true; }
                Text {
                    text: root.update-banner;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 4px;
            Text {
                text: "Claude Dashboard";
                color: Theme.text-primary;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { }
            if root.account-rows.length > 0: FlyoutIconButton {
                glyph: "\u{E72C}";
                tip: "Refresh usage for all accounts";
                enabled: !root.refreshing;
                clicked => { root.refresh(); }
            }
            FlyoutIconButton { glyph: "\u{E740}"; tip: "Open the main window"; clicked => { root.expand(); } }
            FlyoutIconButton { glyph: "\u{E897}"; tip: "Help"; clicked => { root.open-help(); } }
            FlyoutIconButton { glyph: "\u{E713}"; tip: "Open Settings"; clicked => { root.open-settings(); } }
        }
        Rectangle { height: 1px; background: Theme.card-border; }
        if root.account-rows.length == 0: EmptyState {
            title: "No accounts configured";
            compact: true;
            subtitle: "";
            tip: "Open the main window to add a Claude account";
            vertical-stretch: 1;
            add-account => { root.add-account(); }
        }
        // Always present (so the window height can follow `list`); zero-height when empty.
        Flickable {
            vertical-stretch: 1;
            max-height: root.account-rows.length > 0 ? 100000px : 0px;
            content-height: list.preferred-height;
            list := VerticalLayout {
                padding: 12px;
                spacing: 8px;
                alignment: start;
                // As on macOS, only the gauges open anything; the card itself is not clickable.
                for acct in root.account-rows: AccountCard {
                    data: acct;
                    toggle-pin(pinned) => { root.toggle-pin(acct.id, pinned); }
                    resync => { root.resync-account(acct.id); }
                    open-window(w) => { root.open-account-window(acct.id, w); }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.card-border; }
        HorizontalLayout {
            height: 40px;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 8px;
            Rectangle {
                horizontal-stretch: 1;
                Rectangle {
                    x: 0px;
                    width: quit-row.preferred-width + 16px;
                    border-radius: 6px;
                    // macOS HoverableButtonStyle: a neutral wash, not red.
                    background: quit-touch.has-hover ? Theme.text-primary.with-alpha(0.10) : transparent;
                    quit-row := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        Text {
                            text: "\u{E7E8}";
                            font-family: "Segoe Fluent Icons";
                            font-size: 12px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                        Text { text: "Quit"; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; }
                    }
                    quit-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.confirming-quit = true;
                            prompt-keys.focus();
                        }
                    }
                    Tooltip { text: @markdown("Quit the app and stop monitoring usage"); }
                }
            }
            Rectangle {
                width: version.preferred-width;
                version := Text {
                    text: "v" + root.app-version;
                    color: Theme.text-secondary.with-alpha(0.6);
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                Tooltip { text: @markdown("Claude Dashboard \{root.app-version}"); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // Esc cancels and Enter quits while the prompt is up (macOS `.cancelAction` /
    // `.defaultAction`). Always present so the Quit click can focus it.
    prompt-keys := FocusScope {
        enabled: root.confirming-quit;
        width: 0px;
        height: 0px;
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.confirming-quit = false;
                return accept;
            }
            if e.text == Key.Return {
                root.quit();
                return accept;
            }
            reject
        }
    }

    // Inline Quit confirmation (macOS InlinePrompt): dim the flyout, centred card.
    if root.confirming-quit: Rectangle {
        background: #00000059;
        TouchArea { }
        Rectangle {
            width: 260px;
            height: prompt.preferred-height + 32px;
            border-radius: 12px;
            background: Theme.dark ? #2b2b2b : #ffffff;
            border-width: 1px;
            border-color: Theme.card-border;
            prompt := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text { text: "Quit Claude Dashboard?"; color: Theme.text-primary; font-size: 13px; font-weight: 600; }
                Text {
                    text: "Usage monitoring stops until you open the app again.";
                    color: Theme.text-primary;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    padding-top: 4px;
                    PaneButton { horizontal-stretch: 1; label: "Cancel"; tint: Theme.text-primary; tip: "Close without continuing"; clicked => { root.confirming-quit = false; } }
                    PaneButton { horizontal-stretch: 1; label: "Quit"; prominent: true; tip: "Quit the app and stop monitoring usage"; clicked => { root.quit(); } }
                }
            }
        }
    }
}
