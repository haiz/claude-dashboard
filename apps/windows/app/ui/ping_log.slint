import { Theme } from "theme.slint";

// One Ping Log row, built in Rust (`ping_log_view::rows`).
export struct UiPingRow {
    time: string,
    trigger: string,
    account: string,
    outcome: string,
    ok: bool,
    duration: string,
    detail: string,
}

component ConfirmButton inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    callback clicked();
    height: 28px;
    width: t.preferred-width + 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: touch.has-hover ? root.tint.with-alpha(0.15) : Theme.card-bg;
    t := Text { text: root.label; color: root.tint; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Tools > Ping Log (macOS PingLogView): every ping, newest first. The header's Refresh and
// Clear All live in the main window's pane header; Clear All asks here first.
export component PingLogPane inherits VerticalLayout {
    in property <[UiPingRow]> rows;
    in-out property <bool> confirming-clear;
    callback clear();
    spacing: 8px;

    // Esc cancels and Enter clears while asking (macOS confirmationDialog keys).
    if root.confirming-clear: Rectangle {
        height: confirm.preferred-height + 20px;
        border-radius: 8px;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.card-border;
        keys := FocusScope {
            width: 0px;
            height: 0px;
            init => { self.focus(); }
            key-pressed(e) => {
                if e.text == Key.Escape {
                    root.confirming-clear = false;
                    return accept;
                }
                if e.text == Key.Return {
                    root.confirming-clear = false;
                    root.clear();
                    return accept;
                }
                reject
            }
        }
        confirm := HorizontalLayout {
            padding: 10px;
            spacing: 8px;
            Text { text: "Clear the ping log?"; color: Theme.text-primary; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
            ConfirmButton { label: "Cancel"; tint: Theme.text-primary; clicked => { root.confirming-clear = false; } }
            ConfirmButton { label: "Clear All"; tint: Theme.danger; clicked => { root.confirming-clear = false; root.clear(); } }
        }
    }

    Rectangle { height: 1px; background: Theme.card-border; }

    if root.rows.length == 0: VerticalLayout {
        vertical-stretch: 1;
        alignment: center;
        spacing: 12px;
        Text {
            text: "\u{E8C8}";
            font-family: "Segoe Fluent Icons";
            font-size: 40px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
        Text { text: "No pings yet."; color: Theme.text-secondary; horizontal-alignment: center; }
    }

    if root.rows.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: list.preferred-height;
        list := VerticalLayout {
            alignment: start;
            for r in root.rows: VerticalLayout {
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text { text: r.time; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; }
                            // Manual blue, Auto purple (macOS triggerBadge).
                            Rectangle {
                                property <color> tint: r.trigger == "Manual" ? #0a84ff : #bf5af2;
                                width: badge.preferred-width + 12px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 8px;
                                background: self.tint.with-alpha(0.18);
                                badge := Text { text: r.trigger; color: parent.tint; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: r.account; color: Theme.text-primary; font-size: 11px; font-weight: 500; vertical-alignment: center; }
                        }
                        if r.detail != "": Text {
                            text: r.detail;
                            color: Theme.text-secondary;
                            font-size: 13px;
                            wrap: word-wrap;
                            max-height: 2 * 18px;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        Text { text: r.outcome; color: r.ok ? Theme.ok : Theme.danger; font-size: 11px; font-weight: 600; horizontal-alignment: right; }
                        Text { text: r.duration; color: Theme.text-secondary; font-size: 10px; horizontal-alignment: right; }
                    }
                }
                Rectangle { height: 1px; background: Theme.card-border; }
            }
        }
    }
}
