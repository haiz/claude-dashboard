// Color tokens shared by all windows/components. `dark` is driven from Rust
// (or the system scheme); light values are the default.
export global Theme {
    in property <bool> dark: false;

    out property <color> window-bg: dark ? #202020 : #f3f3f3;
    out property <color> card-bg: dark ? #2b2b2b : #ffffff;
    out property <color> card-border: dark ? #3a3a3a : #e5e5e5;
    out property <color> text-primary: dark ? #ffffff : #1a1a1a;
    out property <color> text-secondary: dark ? #c5c5c5 : #5f5f5f;
    out property <color> accent: dark ? #60cdff : #0067c0;
    out property <color> ok: dark ? #6ccb5f : #107c10;
    out property <color> warn: dark ? #fce100 : #9d5d00;
    out property <color> danger: dark ? #ff99a4 : #c42b1c;

    out property <string> font-family: "Segoe UI Variable";
}

export struct UiWindow {
    present: bool,
    percent: float,
    color: color,
    limited: bool,
    reset-label: string,
    countdown: string,
    countdown-color: color,
    // 0..1 fill from core::geometry::fill_fraction.
    fraction: float,
    // Slint Path commands for the progress arc, built in Rust from core::geometry.
    gauge-path: string,
    // Ring diameter / stroke width (core::geometry metrics), in logical px.
    diameter: float,
    line-width: float,
}

export struct UiRow {
    id: string,
    name: string,
    email: string,
    initial: string,
    plan: string,
    status: string,
    peak: float,
    peak-color: color,
    five-hour: UiWindow,
    seven-day: UiWindow,
    fable: UiWindow,
    avatar-color: color,
    animal: string,
    staleness: string,
    error: string,
    extension-sourced: bool,
    claude-code: bool,
}
