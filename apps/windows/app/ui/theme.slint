// Color tokens shared by all windows/components. `dark` is driven from Rust
// (or the system scheme); light values are the default.
export global Theme {
    in property <bool> dark: false;

    out property <color> window-bg: dark ? #202020 : #f3f3f3;
    out property <color> card-bg: dark ? #2b2b2b : #ffffff;
    out property <color> card-border: dark ? #3a3a3a : #e5e5e5;
    out property <color> text-primary: dark ? #ffffff : #1a1a1a;
    out property <color> text-secondary: dark ? #c5c5c5 : #5f5f5f;
    out property <color> accent: dark ? #60cdff : #0067c0;
    out property <color> ok: dark ? #6ccb5f : #107c10;
    out property <color> warn: dark ? #fce100 : #9d5d00;
    out property <color> danger: dark ? #ff99a4 : #c42b1c;

    out property <string> font-family: "Segoe UI Variable";
}

export struct UiSegment {
    path: string,
    color: color,
}

export struct UiWindow {
    present: bool,
    percent: float,
    color: color,
    limited: bool,
    reset-label: string,
    countdown: string,
    countdown-color: color,
    // 0..1 fill from core::geometry::fill_fraction.
    fraction: float,
    // Slint Path commands for the progress arc, built in Rust from core::geometry.
    gauge-path: string,
    // Ring diameter / stroke width (core::geometry metrics), in logical px.
    diameter: float,
    line-width: float,
    // Countdown ring segments (core::geometry::countdown_segments), blue -> green under 30% left,
    // and the segmented grey track; each built at the ring's drawn size (regular 44 px, compact
    // 34 px) so the gaps stay 2 px as on macOS.
    segments: [UiSegment],
    segments-compact: [UiSegment],
    track: [string],
    track-compact: [string],
    // Burn-rate animal emoji of this window ("" when unknown or the setting is off). Data only:
    // no gauge draws it; the 5h ring animates `animal-asset` instead.
    animal: string,
    // 5h window only. Stable asset id ("snail" .. "cheetah") of the animal to animate, "" when
    // the setting is off, no burn-rate animal is known or the packaged manifest is invalid.
    animal-asset: string,
    // 5h window only. Monotonic app-clock seconds (animal_assets::monotonic_now) at which the
    // 5h value's last change stops counting (+600 s); -1 = no change seen since launch.
    // Eligible while `animal-asset != "" && clock <= animal-expires-at`. The phase is NOT here:
    // it is one app-wide property so row refreshes never restart the animation.
    animal-expires-at: float,
}

// Compile-time references so every burn-animal sprite sheet (768x512, 6x4 cells of 128 px,
// row-major, 24 frames) is packaged in the Windows build.
export global BurnAnimalSheets {
    public pure function sheet(id: string) -> image {
        if id == "snail" { return @image-url("assets/burn-animals/snail.png"); }
        if id == "turtle" { return @image-url("assets/burn-animals/turtle.png"); }
        if id == "rabbit" { return @image-url("assets/burn-animals/rabbit.png"); }
        if id == "horse" { return @image-url("assets/burn-animals/horse.png"); }
        if id == "cheetah" { return @image-url("assets/burn-animals/cheetah.png"); }
        return @image-url("assets/burn-animals/snail.png");
    }
}

// The one app-wide burn-animal clock, published from Rust (`animal_clock.rs`, core
// AnimalDisplayPhase) by a single 12 fps UI-thread timer; every 5h ring reads it, so all cards
// share one phase. The defaults are the stopped clock: percentage only.
export global BurnAnimalClock {
    // Monotonic app seconds (animal_assets::monotonic_now), compared with `animal-expires-at`.
    in property <float> clock;
    // The phase samples an animal frame (5.5 s to 10 s of the 10 s cycle).
    in property <bool> sampled;
    in property <float> percent-opacity: 1.0;
    in property <float> animal-opacity;
    // Top-left sheet pixel of the frame's 128 px cell (animal_assets::cell_origin).
    in property <int> clip-x;
    in property <int> clip-y;
}

export struct UiRow {
    id: string,
    name: string,
    email: string,
    initial: string,
    plan: string,
    status: string,
    peak: float,
    peak-color: color,
    five-hour: UiWindow,
    seven-day: UiWindow,
    fable: UiWindow,
    avatar-color: color,
    animal: string,
    staleness: string,
    error: string,
    extension-sourced: bool,
    claude-code: bool,
    pinned: bool,
    expired: bool,
    kind-label: string,
    expired-hint: string,
    sidebar-percent: float,
    sidebar-color: color,
    has-sidebar-percent: bool,
    // True while a refresh covering this account is in flight (card spinner).
    loading: bool,
    // The account page's Ping row (macOS AccountPane): a ping is running, and the latest
    // ping's caption, red when it failed.
    pinging: bool,
    ping-caption: string,
    ping-failed: bool,
    // Claude Code Switch (macOS SwitchAvailability): "" (no switcher) | active | ready |
    // not-captured | login-expired | needs-login, and its tooltip.
    switch-state: string,
    switch-help: string,
    // Auto Switch (macOS AccountCard bolt / flame): the home account, whether the bolt can be
    // ticked, and the critical level (0 none, 1 critical, 2 high critical) with its tooltip.
    is-home: bool,
    shows-home: bool,
    critical-level: int,
    critical-help: string,
}
