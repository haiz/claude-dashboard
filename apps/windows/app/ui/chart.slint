import { Theme } from "theme.slint";

// A tick on one axis: `pos` is the pixel coordinate inside the chart
// (x for the time axis, y for the value axis); all of it is computed in Rust
// from core::chart.
export struct ChartTick {
    pos: float,
    label: string,
}

// One extra line on a multi-series plot (Overview); `slot` indexes
// `ChartColors.lines` (macOS colours by list position).
export struct ChartLine {
    path: string,
    slot: int,
}

export struct ChartLegendItem {
    id: string,
    name: string,
    // "" when the name already is the email.
    email: string,
    slot: int,
    on: bool,
}

// One row of the hover card: History has one unnamed row, the Overview one
// per shown account. `rate` is "--" when there is none.
export struct ChartTipRow {
    name: string,
    slot: int,
    value: string,
    rate: string,
    has-rate: bool,
    rate-up: bool,
}

export struct ChartPoint {
    x: float,
    y: float,
}

// One row of the History "Reset Cycles" list.
export struct ChartCycle {
    label: string,
    peak: string,
    points: string,
    color: color,
    selected: bool,
}

// Everything the History box does goes through here (handled in history.rs); the
// chart's own state comes back through `HistoryData`.
export global ChartActions {
    // (account id, window "5h" | "7d" | "fable"); an empty id closes the chart.
    callback open(string, string);
    callback preset(string);
    callback toggle-mode();
    callback toggle-ruler();
    callback size(float, float);
    callback hover(float, float);
    callback select(float, float);
    callback pan(float);
    callback click(float, float);
    callback reset();
    callback select-cycle(int);
    callback show-all();
}

// macOS system colours (light / dark) the charts use.
export global ChartColors {
    // OverviewChartView.lineColors: orange, cyan, green, purple, pink, blue,
    // yellow, mint, indigo, red.
    out property <[color]> lines: Theme.dark
        ? [#ff9f0a, #64d2ff, #30d158, #bf5af2, #ff375f, #0a84ff, #ffd60a, #63e6e2, #5e5ce6, #ff453a]
        : [#ff9500, #32ade6, #34c759, #af52de, #ff2d55, #007aff, #ffcc00, #00c7be, #5856d6, #ff3b30];
    out property <color> blue: Theme.dark ? #0a84ff : #007aff;
    out property <color> orange: Theme.dark ? #ff9f0a : #ff9500;
    out property <color> green: Theme.dark ? #30d158 : #34c759;
    out property <color> red: Theme.dark ? #ff453a : #ff3b30;
    out property <color> cyan: Theme.dark ? #64d2ff : #32ade6;
    // SwiftUI `.tertiary` text.
    out property <color> tertiary: Theme.text-secondary.with-alpha(0.6);
}

export struct ChartState {
    // Container state shared by the History box and the Overview.
    custom: bool,
    pan-mode: bool,
    ruler: bool,
    noon-path: string,
    avg-text: string,
    avg-hot: bool,
    measure-a-visible: bool,
    measure-a-x: float,
    measure-b-visible: bool,
    measure-b-x: float,
    measure-range: string,
    measure-delta: string,
    measure-duration: string,
    measure-up: bool,
    // Empty-state second line.
    hint: string,
    // History only: day bands, the 100% rule, dashed 5h-reset rules, their
    // markers, limit points, cycles.
    band-path: string,
    limit-path: string,
    reset-path: string,
    reset-marks: [ChartTick],
    limit-points: [ChartPoint],
    cycles: [ChartCycle],
    has-cycle: bool,
    // Overview only: one line per selected account, the account legend and
    // the window selector value ("5h" / "7d" / "fable").
    lines: [ChartLine],
    legend: [ChartLegendItem],
    window: string,
    // Slint Path commands for the usage line (breaks at resets).
    line-path: string,
    x-ticks: [ChartTick],
    y-ticks: [ChartTick],
    // Dashed vertical gridlines at the x ticks.
    grid-path: string,
    // Pointer over the plot: the dashed hover rule (+ ruler crosshair) and the card,
    // pinned to the top corner away from the pointer.
    cross-visible: bool,
    cross-path: string,
    tip-visible: bool,
    tip-left: bool,
    tip-time: string,
    tip-rows: [ChartTipRow],
    empty: bool,
    loading: bool,
    preset: string,
    // Plot frame (px), 0..105% tall, so it matches chart.rs's scale.
    plot-left: float,
    plot-top: float,
    plot-width: float,
    plot-height: float,
}

export global HistoryData {
    in-out property <ChartState> state;
}

// macOS HoverableButtonStyle as a text toggle (range presets, Show All).
component RangeButton inherits VerticalLayout {
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <bool> bold: true;
    in property <length> pad: 6px;
    // Hover tooltip (macOS `.help`); empty shows none.
    in property <string> tip;
    callback clicked();
    alignment: center;
    Rectangle {
        width: t.preferred-width + 2 * root.pad;
        height: t.preferred-height + 6px;
        border-radius: 4px;
        opacity: root.enabled ? 1.0 : 0.45;
        background: !root.enabled ? transparent
            : touch.pressed ? Theme.text-primary.with-alpha(0.18)
            : root.active ? Theme.accent.with-alpha(touch.has-hover ? 0.28 : 0.2)
            : touch.has-hover ? Theme.text-primary.with-alpha(0.10) : transparent;
        t := Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: 12px;
            font-weight: root.bold ? 700 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
        if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
    }
}

// A 20 px Segoe Fluent Icons button (macOS icon buttons: pan / zoom, ruler).
component IconButton inherits VerticalLayout {
    in property <string> glyph;
    in property <color> color: Theme.text-primary;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked();
    alignment: center;
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 4px;
        opacity: root.enabled ? 1.0 : 0.45;
        background: !root.enabled ? transparent
            : touch.pressed ? Theme.text-primary.with-alpha(0.18)
            : touch.has-hover ? Theme.text-primary.with-alpha(0.10) : transparent;
        Text {
            text: root.glyph;
            font-family: "Segoe Fluent Icons";
            font-size: 14px;
            color: root.color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
        if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
    }
}

component ToolDivider inherits VerticalLayout {
    alignment: center;
    Rectangle { width: 1px; height: 16px; background: Theme.card-border; }
}

// macOS UsageWindowPicker: a segmented 5h / 7d / F control, 180 px wide.
component WindowPicker inherits VerticalLayout {
    in property <string> value;
    callback picked(string);
    alignment: center;
    Rectangle {
        width: 180px;
        height: 26px;
        border-radius: 7px;
        background: Theme.text-primary.with-alpha(0.06);
        HorizontalLayout {
            padding: 2px;
            spacing: 2px;
            for w[i] in ["5h", "7d", "fable"]: Rectangle {
                horizontal-stretch: 1;
                border-radius: 5px;
                background: seg.pressed ? Theme.text-primary.with-alpha(0.18)
                    : root.value == w ? Theme.accent.with-alpha(seg.has-hover ? 0.28 : 0.2)
                    : seg.has-hover ? Theme.text-primary.with-alpha(0.10) : transparent;
                Text {
                    text: i == 2 ? "F" : w;
                    color: Theme.text-primary;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                seg := TouchArea { clicked => { root.picked(w); } }
                Tooltip { text: @markdown("Show the \{i == 0 ? "5-hour" : i == 1 ? "7-day" : "Fable"} usage window"); }
            }
        }
    }
}

// macOS InteractiveChartContainer toolbar: mode, presets, Custom, Avg, then the
// window picker and (History) Show All and the ruler.
component ChartToolbar inherits HorizontalLayout {
    in property <ChartState> state;
    in property <bool> history: false;
    callback toggle-mode();
    callback preset(string);
    callback window(string);
    callback show-all();
    callback toggle-ruler();
    spacing: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;

    // Hand = pan, magnifier = zoom (the glyph shows the current mode).
    IconButton {
        glyph: root.state.pan-mode ? "\u{E7C9}" : "\u{E71E}";
        tip: root.state.pan-mode ? "Switch to zoom mode" : "Switch to pan mode";
        enabled: !root.state.ruler;
        clicked => { root.toggle-mode(); }
    }
    ToolDivider { }
    for p in ["5h", "24h", "3d", "7d", "30d"]: RangeButton {
        label: p;
        tip: "Show the last " + p;
        active: !root.state.custom && root.state.preset == p;
        enabled: !root.state.ruler;
        clicked => { root.preset(p); }
    }
    if root.state.custom: Text {
        text: "Custom";
        color: Theme.text-secondary;
        font-size: 10px;
        vertical-alignment: center;
    }
    Rectangle { horizontal-stretch: 1; }
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: avg.preferred-width + 12px;
            height: avg.preferred-height + 8px;
            border-radius: 4px;
            background: Theme.text-primary.with-alpha(0.05);
            avg := Text {
                text: root.state.avg-text;
                color: root.state.avg-text == "Avg: --" ? Theme.text-secondary
                    : (root.state.avg-hot ? ChartColors.orange : ChartColors.green);
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    Rectangle { horizontal-stretch: 1; }
    WindowPicker {
        value: root.state.window;
        picked(w) => { root.window(w); }
    }
    if root.history && root.state.has-cycle: RangeButton {
        label: "Show All";
        bold: false;
        pad: 10px;
        tip: "Show every reset cycle on the chart";
        clicked => { root.show-all(); }
    }
    if root.history: ToolDivider { }
    if root.history: IconButton {
        glyph: "\u{ED5E}";
        color: root.state.ruler ? Theme.accent : Theme.text-primary;
        tip: root.state.ruler ? "Turn off measure tool" : "Measure tool: click 2 points to see Δ%";
        clicked => { root.toggle-ruler(); }
    }
}

// macOS "No data yet" state: a chart glyph and the text, in place of the chart.
component EmptyChart inherits VerticalLayout {
    in property <string> hint;
    alignment: center;
    spacing: 8px;
    Text {
        text: "\u{EB0F}";
        font-family: "Segoe Fluent Icons";
        font-size: 36px;
        color: Theme.text-secondary;
        horizontal-alignment: center;
    }
    Text {
        text: "No data yet";
        color: Theme.text-secondary;
        font-size: 12px;
        horizontal-alignment: center;
    }
    if root.hint != "": Text {
        text: root.hint;
        color: ChartColors.tertiary;
        font-size: 11px;
        horizontal-alignment: center;
    }
}

// The plot. Pointer x/y are forwarded in px; Rust decides what they mean.
export component InteractiveChart inherits Rectangle {
    in property <ChartState> state;
    // History: one fixed blue line (macOS); the Overview draws `state.lines`.
    in property <color> line-color: ChartColors.blue;
    in property <length> line-width: 2px;
    callback size-changed(float, float);
    callback hover(float, float);
    callback select(float, float);
    callback reset();
    // Pan mode: pointer movement since the last event (px); ruler: a click.
    callback pan(float);
    callback click(float, float);

    // UI-only drag bookkeeping (pixels).
    property <length> drag-x0;
    property <length> last-x;
    // `dragging`: zoom selection in progress; `panning`: pan drag; `armed`: ruler press.
    property <bool> dragging;
    property <bool> panning;
    property <bool> armed;
    // The plot frame (no border, as macOS).
    property <length> fl: root.state.plot-left * 1px;
    property <length> ft: root.state.plot-top * 1px;
    property <length> fw: root.state.plot-width * 1px;
    property <length> fh: root.state.plot-height * 1px;

    // `changed` does not fire for the first layout, so report the size on init too.
    init => { root.size-changed(self.width / 1px, self.height / 1px); }
    changed width => { root.size-changed(self.width / 1px, self.height / 1px); }
    changed height => { root.size-changed(self.width / 1px, self.height / 1px); }

    // Under the line: day bands, gridlines, noon / 5h-reset rules, the 100% rule.
    Rectangle {
        x: root.fl;
        y: root.ft;
        width: root.fw;
        height: root.fh;
        clip: true;
        Path {
            x: -root.fl;
            y: -root.ft;
            width: root.width;
            height: root.height;
            viewbox-width: root.width / 1px;
            viewbox-height: root.height / 1px;
            commands: root.state.band-path;
            fill: Theme.text-primary.with-alpha(0.04);
            stroke: transparent;
        }
        for t in root.state.y-ticks: Rectangle {
            x: 0;
            // The 0% line sits on the frame's bottom edge: keep it inside the clip.
            y: min(t.pos * 1px - root.ft, root.fh - 1px);
            width: root.fw;
            height: 1px;
            background: Theme.card-border;
        }
        Path {
            x: -root.fl;
            y: -root.ft;
            width: root.width;
            height: root.height;
            viewbox-width: root.width / 1px;
            viewbox-height: root.height / 1px;
            commands: root.state.grid-path;
            stroke: Theme.card-border;
            stroke-width: 1px;
            fill: transparent;
        }
        Path {
            x: -root.fl;
            y: -root.ft;
            width: root.width;
            height: root.height;
            viewbox-width: root.width / 1px;
            viewbox-height: root.height / 1px;
            commands: root.state.noon-path;
            stroke: Theme.text-secondary.with-alpha(0.15);
            stroke-width: 1px;
            fill: transparent;
        }
        Path {
            x: -root.fl;
            y: -root.ft;
            width: root.width;
            height: root.height;
            viewbox-width: root.width / 1px;
            viewbox-height: root.height / 1px;
            commands: root.state.reset-path;
            stroke: ChartColors.cyan.with-alpha(0.4);
            stroke-width: 1px;
            fill: transparent;
        }
        Path {
            x: -root.fl;
            y: -root.ft;
            width: root.width;
            height: root.height;
            viewbox-width: root.width / 1px;
            viewbox-height: root.height / 1px;
            commands: root.state.limit-path;
            stroke: ChartColors.red.with-alpha(0.3);
            stroke-width: 1px;
            fill: transparent;
        }
    }

    // Y labels on the right (macOS).
    for t in root.state.y-ticks: Text {
        x: root.fl + root.fw + 6px;
        y: t.pos * 1px - 8px;
        height: 16px;
        text: t.label;
        color: Theme.text-secondary;
        font-size: 10px;
        vertical-alignment: center;
    }

    // X labels, leading-aligned at their gridline.
    for t in root.state.x-ticks: Text {
        x: t.pos * 1px + 3px;
        y: root.ft + root.fh + 4px;
        text: t.label;
        color: Theme.text-secondary;
        font-size: 10px;
    }

    // The lines (clipped to the plot frame).
    Rectangle {
        x: root.fl;
        y: root.ft;
        width: root.fw;
        height: root.fh;
        clip: true;
        Path {
            x: -root.fl;
            y: -root.ft;
            width: root.width;
            height: root.height;
            viewbox-width: root.width / 1px;
            viewbox-height: root.height / 1px;
            commands: root.state.line-path;
            stroke: root.line-color;
            stroke-width: root.line-width;
            stroke-line-join: round;
            stroke-line-cap: round;
            fill: transparent;
        }
        for ln in root.state.lines: Path {
            x: -root.fl;
            y: -root.ft;
            width: root.width;
            height: root.height;
            viewbox-width: root.width / 1px;
            viewbox-height: root.height / 1px;
            commands: ln.path;
            stroke: ChartColors.lines[ln.slot];
            stroke-width: root.line-width;
            stroke-line-join: round;
            stroke-line-cap: round;
            fill: transparent;
        }
    }

    // 5h reset markers (7d window) along the top edge.
    for m in root.state.reset-marks: Text {
        x: m.pos * 1px - 5px;
        y: root.ft + 1px;
        text: m.label;
        color: ChartColors.cyan.with-alpha(0.7);
        font-family: "Segoe UI Symbol";
        font-size: 11px;
    }

    // Limit points: a red dot with a warning sign above.
    for p in root.state.limit-points: Rectangle {
        x: p.x * 1px - 3px;
        y: p.y * 1px - 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: ChartColors.red;
        Text {
            x: -4px;
            y: -17px;
            text: "\u{26A0}";
            color: Theme.text-primary;
            font-size: 11px;
        }
    }

    // Ruler: points A / B and the band between them.
    if root.state.measure-a-visible && root.state.measure-b-visible: Rectangle {
        x: min(root.state.measure-a-x, root.state.measure-b-x) * 1px;
        y: root.ft;
        width: abs(root.state.measure-b-x - root.state.measure-a-x) * 1px;
        height: root.fh;
        background: Theme.accent.with-alpha(0.12);
    }
    if root.state.measure-a-visible: Rectangle {
        x: root.state.measure-a-x * 1px;
        y: root.ft;
        width: 1px;
        height: root.fh;
        background: Theme.accent.with-alpha(0.8);
    }
    if root.state.measure-b-visible: Rectangle {
        x: root.state.measure-b-x * 1px;
        y: root.ft;
        width: 1px;
        height: root.fh;
        background: Theme.accent.with-alpha(0.8);
    }

    // Drag selection (macOS zoomSelectionHighlight).
    if root.dragging: Rectangle {
        x: min(root.drag-x0, touch.mouse-x);
        y: root.ft;
        width: abs(touch.mouse-x - root.drag-x0);
        height: root.fh;
        background: Theme.accent.with-alpha(0.15);
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.5);
    }

    // Dashed hover rule (+ the ruler's horizontal crosshair).
    if root.state.cross-visible && !root.dragging && !root.panning: Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: root.state.cross-path;
        stroke: Theme.text-secondary.with-alpha(0.5);
        stroke-width: 1px;
        fill: transparent;
    }

    // Hover card, pinned to the top corner away from the pointer.
    if root.state.tip-visible && !root.dragging && !root.panning: Rectangle {
        width: tip-box.preferred-width;
        height: tip-box.preferred-height;
        x: root.state.tip-left ? root.fl + 8px : root.fl + root.fw - self.width - 8px;
        y: root.ft + 8px;
        border-radius: 6px;
        background: Theme.card-bg.with-alpha(0.94);
        border-width: 1px;
        border-color: Theme.card-border;
        tip-box := VerticalLayout {
            padding: 8px;
            spacing: 3px;
            Text {
                text: root.state.tip-time;
                color: Theme.text-secondary;
                font-size: 10px;
                font-weight: 700;
            }
            for r in root.state.tip-rows: HorizontalLayout {
                spacing: r.name == "" ? 6px : 4px;
                if r.name != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: ChartColors.lines[r.slot];
                    }
                }
                if r.name != "": Text {
                    text: r.name;
                    color: Theme.text-primary;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                if r.name != "": Rectangle { min-width: 8px; horizontal-stretch: 1; }
                if r.value != "": Text {
                    text: r.value;
                    color: Theme.text-primary;
                    font-size: r.name == "" ? 12px : 11px;
                    font-weight: r.name == "" ? 700 : 400;
                    vertical-alignment: center;
                }
                Text {
                    text: r.rate;
                    color: !r.has-rate ? ChartColors.tertiary : (r.rate-up ? ChartColors.orange : ChartColors.green);
                    font-size: r.name == "" ? 12px : 11px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Ruler result card, in the same corner as the hover card.
    if root.state.measure-b-visible: Rectangle {
        width: card.preferred-width;
        height: card.preferred-height;
        x: root.state.tip-left ? root.fl + 8px : root.fl + root.fw - self.width - 8px;
        y: root.ft + 8px;
        border-radius: 6px;
        background: Theme.card-bg.with-alpha(0.94);
        border-width: 1px;
        border-color: Theme.card-border;
        card := VerticalLayout {
            padding: 8px;
            spacing: 3px;
            Text { text: root.state.measure-range; color: Theme.text-secondary; font-size: 10px; }
            Text {
                text: root.state.measure-delta;
                color: root.state.measure-up ? ChartColors.orange : ChartColors.green;
                font-size: 12px;
                font-weight: 700;
            }
            Text { text: root.state.measure-duration; color: Theme.text-secondary; font-size: 10px; }
        }
    }

    touch := TouchArea {
        mouse-cursor: root.state.ruler ? MouseCursor.crosshair : (root.state.pan-mode ? MouseCursor.grab : MouseCursor.default);
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.drag-x0 = self.mouse-x;
                root.last-x = self.mouse-x;
                if root.state.ruler {
                    root.armed = true;
                } else if root.state.pan-mode {
                    root.panning = true;
                } else {
                    root.dragging = true;
                }
            } else if e.kind == PointerEventKind.up {
                if root.dragging {
                    root.dragging = false;
                    if abs(self.mouse-x - root.drag-x0) > 6px {
                        root.select(root.drag-x0 / 1px, self.mouse-x / 1px);
                    }
                }
                root.panning = false;
                if root.armed {
                    root.armed = false;
                    root.click(self.mouse-x / 1px, self.mouse-y / 1px);
                }
            } else if e.kind == PointerEventKind.cancel {
                root.dragging = false;
                root.panning = false;
                root.armed = false;
            } else if e.kind == PointerEventKind.move && !root.dragging && !root.panning {
                root.hover(self.mouse-x / 1px, self.mouse-y / 1px);
            }
        }
        moved => {
            if root.panning {
                root.pan((self.mouse-x - root.last-x) / 1px);
                root.last-x = self.mouse-x;
            }
        }
        changed has-hover => {
            if !self.has-hover { root.hover(-1, -1); }
        }
        double-clicked => {
            root.dragging = false;
            root.panning = false;
            if !root.state.ruler { root.reset(); }
        }
    }
}

// The account page's History box (macOS AccountDetailView + InteractiveChartContainer):
// toolbar (pan/zoom, presets, Custom, Avg, window picker, Show All, ruler), the chart and
// the collapsible Reset Cycles list; with no data, the "No data yet" state replaces the
// toolbar and chart. State comes from `HistoryData`, input goes to `ChartActions`; picking
// a window is reported to the page (`window-picked`) so the gauges and the picker share
// one path.
export component HistoryBox inherits VerticalLayout {
    callback window-picked(string);
    property <ChartState> st: HistoryData.state;
    property <bool> cycles-open: false;
    property <bool> no-data: root.st.empty && !root.st.loading;
    spacing: 8px;

    Text {
        text: "History";
        color: Theme.text-primary;
        font-size: 14px;
        font-weight: 600;
    }
    Rectangle {
        height: inner.preferred-height;
        background: Theme.card-bg;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.card-border;
        inner := VerticalLayout {
            padding: 12px;
            spacing: 8px;

            if !root.no-data: ChartToolbar {
                state: root.st;
                history: true;
                toggle-mode => { ChartActions.toggle-mode(); }
                preset(p) => { ChartActions.preset(p); }
                window(w) => { root.window-picked(w); }
                show-all => { ChartActions.show-all(); }
                toggle-ruler => { ChartActions.toggle-ruler(); }
            }

            if !root.no-data: Rectangle {
                height: 250px;
                InteractiveChart {
                    width: parent.width;
                    height: parent.height;
                    state: root.st;
                    size-changed(w, h) => { ChartActions.size(w, h); }
                    hover(x, y) => { ChartActions.hover(x, y); }
                    select(a, b) => { ChartActions.select(a, b); }
                    pan(dx) => { ChartActions.pan(dx); }
                    click(x, y) => { ChartActions.click(x, y); }
                    reset => { ChartActions.reset(); }
                }
            }
            if root.no-data: EmptyChart {
                min-height: 200px;
                hint: root.st.hint;
            }

            if root.st.cycles.length > 0: Rectangle { height: 1px; background: Theme.card-border; }
            if root.st.cycles.length > 0: Rectangle {
                height: 28px;
                background: head-touch.has-hover ? Theme.accent.with-alpha(0.08) : transparent;
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    Text {
                        text: "Reset Cycles";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.cycles-open ? "\u{E70D}" : "\u{E76C}";
                        font-family: "Segoe Fluent Icons";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
                head-touch := TouchArea { clicked => { root.cycles-open = !root.cycles-open; } }
                Tooltip { text: @markdown("\{root.cycles-open ? "Hide the reset cycles" : "Show the reset cycles"}"); }
            }
            if root.st.cycles.length > 0 && root.cycles-open: Flickable {
                height: min(150px, rows.preferred-height);
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    for c[i] in root.st.cycles: Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: c.selected ? Theme.accent.with-alpha(0.18) : (row-touch.has-hover ? Theme.accent.with-alpha(0.08) : transparent);
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 8px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                background: c.color;
                            }
                            Text {
                                text: c.label;
                                color: Theme.text-primary;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Text { text: c.peak; color: Theme.text-secondary; font-size: 12px; vertical-alignment: center; }
                            Text { text: c.points; color: Theme.text-secondary.with-alpha(0.7); font-size: 11px; vertical-alignment: center; }
                        }
                        row-touch := TouchArea { clicked => { ChartActions.select-cycle(i); } }
                        Tooltip { text: @markdown("Show only this cycle on the chart"); }
                    }
                }
            }
        }
    }
}

// Overview (macOS OverviewChartView): the toolbar and a 300 px chart with one line
// per selected account on shared axes, then the account list (click to show / hide a
// line). Double-click on the chart resets the range (Windows only).
export component OverviewPane inherits VerticalLayout {
    in property <ChartState> state;
    callback window(string);
    callback preset(string);
    callback toggle(string);
    callback size-changed(float, float);
    callback hover(float, float);
    callback select(float, float);
    callback pan(float);
    callback toggle-mode();
    callback reset();
    property <bool> no-data: root.state.empty && !root.state.loading;
    spacing: 0;

    if !root.no-data: ChartToolbar {
        state: root.state;
        toggle-mode => { root.toggle-mode(); }
        preset(p) => { root.preset(p); }
        window(w) => { root.window(w); }
    }
    if !root.no-data: Rectangle {
        height: 300px;
        InteractiveChart {
            width: parent.width;
            height: parent.height;
            state: root.state;
            line-width: 1.5px;
            size-changed(w, h) => { root.size-changed(w, h); }
            hover(x, y) => { root.hover(x, y); }
            select(a, b) => { root.select(a, b); }
            pan(dx) => { root.pan(dx); }
            reset => { root.reset(); }
        }
    }
    if root.no-data: EmptyChart { height: 300px; }
    Rectangle { height: 1px; background: Theme.card-border; }
    Flickable {
        vertical-stretch: 1;
        content-height: legend.preferred-height;
        legend := VerticalLayout {
            alignment: start;
            spacing: 4px;
            padding-top: 4px;
            padding-bottom: 4px;
            for item in root.state.legend: Rectangle {
                height: row.preferred-height;
                background: item.on ? Theme.accent.with-alpha(0.12)
                    : (lt-touch.has-hover ? Theme.text-primary.with-alpha(0.07) : transparent);
                row := HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: item.on ? ChartColors.lines[item.slot] : Theme.text-secondary.with-alpha(0.3);
                        }
                    }
                    Text {
                        text: item.name;
                        color: item.on ? Theme.text-primary : Theme.text-secondary;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    if item.email != "": Text {
                        text: item.email;
                        color: ChartColors.tertiary;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                lt-touch := TouchArea { clicked => { root.toggle(item.id); } }
                Tooltip { text: @markdown("\{item.on ? "Hide this account on the chart" : "Show this account on the chart"}"); }
            }
        }
    }
}
