import { Theme } from "theme.slint";

// One setting's explanation (macOS `SettingTip`): `summary` is the hover tooltip; the click
// popup shows `detail`, `example` and a "More in Help" link to `help-topic`.
export struct TipData {
    id: string,
    summary: string,
    detail: string,
    example: string,
    help-topic: string,
}

// Filled from `tips.rs`; Rust connects `more-help` to `AppWindow.open-help`.
export global TipStore {
    in property <[TipData]> tips;
    callback more-help(string);
}

// macOS `InfoTip`: an info icon. Hover shows the summary, click opens detail + example +
// "More in Help".
export component InfoTip inherits Rectangle {
    in property <string> tip-id;
    width: 16px;
    height: 16px;

    for t in TipStore.tips: Rectangle {
        if t.id == root.tip-id: Rectangle {
            width: 16px;
            height: 16px;
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 7px;
                border-width: 1px;
                border-color: touch.has-hover ? Theme.accent : Theme.text-secondary;
                Text {
                    text: "i";
                    font-size: 10px;
                    font-weight: 700;
                    color: touch.has-hover ? Theme.accent : Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            touch := TouchArea {
                accessible-role: button;
                accessible-label: "About this setting";
                clicked => { pop.show(); }
            }
            // Hover summary (the macOS `.help` tooltip).
            if touch.has-hover: Rectangle {
                x: 22px;
                y: -4px;
                width: tip-text.preferred-width + 16px;
                height: 24px;
                border-radius: 4px;
                background: Theme.card-bg;
                border-width: 1px;
                border-color: Theme.card-border;
                tip-text := Text {
                    x: 8px;
                    text: t.summary;
                    font-size: 12px;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
            }
            pop := PopupWindow {
                x: 22px;
                y: -8px;
                width: 340px;
                Rectangle {
                    background: Theme.card-bg;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.card-border;
                }
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Text { text: t.detail; color: Theme.text-primary; font-size: 13px; wrap: word-wrap; }
                    Text { text: "Example"; color: Theme.text-secondary; font-size: 11px; font-weight: 700; }
                    Text { text: t.example; color: Theme.text-secondary; font-size: 13px; wrap: word-wrap; }
                    Text {
                        text: "More in Help";
                        color: Theme.accent;
                        font-size: 13px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { TipStore.more-help(t.help-topic); }
                        }
                    }
                }
            }
        }
    }
}
